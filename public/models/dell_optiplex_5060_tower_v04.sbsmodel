lue\": {\n        \"standard_DisplayPort\": 2,\n        \"optional_module\": [\n          \"HDMI 2.0b\",\n          \"DisplayPort\",\n          \"VGA\",\n          \"USB-C DisplayPort Alt Mode\"\n        ]\n      },\n      \"unit\": \"outputs\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.ports\"\n      ],\n      \"notes\": \"Optional module entries are alternatives, not a guaranteed simultaneous port population.\"\n    },\n    {\n      \"id\": \"claim.io.ethernet\",\n      \"subject_id\": \"rear.rj45\",\n      \"predicate\": \"ethernet_port\",\n      \"value\": {\n        \"count\": 1,\n        \"connector\": \"RJ-45\",\n        \"class\": \"Gigabit Ethernet\"\n      },\n      \"unit\": \"port\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.ports\"\n      ]\n    },\n    {\n      \"id\": \"claim.cpu.supported_options\",\n      \"subject_id\": \"motherboard.cpu_socket\",\n      \"predicate\": \"supported_processor_options\",\n      \"value\": [\n        \"Intel Pentium Gold G5400\",\n        \"Intel Pentium Gold G5500\",\n        \"Intel Core i3-8100\",\n        \"Intel Core i3-8300\",\n        \"Intel Core i5-8400\",\n        \"Intel Core i5-8500\",\n        \"Intel Core i5-8600\",\n        \"Intel Core i7-8700\"\n      ],\n      \"unit\": \"models\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.processors\",\n        \"src.dell.5060.spec_sheet\",\n        \"src.intel.g5400\",\n        \"src.intel.g5500\"\n      ],\n      \"notes\": \"Supported option list only, not a fitted CPU. Dell's data sheet lists 65 W for standard non-T options; Intel ARK reports different processor TDP values for G5400/G5500, with a separate 65 W thermal-solution specification. The service-manual 35 W row is not reconciled to T-suffix options.\"\n    },\n    {\n      \"id\": \"claim.fan.grommet_count\",\n      \"subject_id\": \"cooling.system_fan\",\n      \"predicate\": \"documented_mounting_grommets\",\n      \"value\": 4,\n      \"unit\": \"grommets\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.system_fan\"\n      ],\n      \"notes\": \"Dell documents rubber grommet retention; the four-instance count follows the mounting arrangement in the service procedure, not measured dimensions.\"\n    },\n    {\n      \"id\": \"claim.cpu.heatsink_fasteners\",\n      \"subject_id\": \"cooling.cpu.heatsink\",\n      \"predicate\": \"captive_heatsink_screws\",\n      \"value\": 4,\n      \"unit\": \"screws\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.heatsink\"\n      ],\n      \"notes\": \"Loosening order 1–4 is documented; installed screw coordinates and torque are not supplied.\"\n    },\n    {\n      \"id\": \"claim.cpu.power_rating_discrepancy\",\n      \"subject_id\": \"motherboard.cpu_socket\",\n      \"predicate\": \"processor_power_values_by_source\",\n      \"value\": {\n        \"Pentium Gold G5400\": {\n          \"dell_datasheet_rating_w\": 65,\n          \"intel_ark_tdp_w\": 58,\n          \"intel_thermal_solution_spec_w\": 65,\n          \"integrated_graphics\": \"UHD Graphics 610\"\n        },\n        \"Pentium Gold G5500\": {\n          \"dell_datasheet_rating_w\": 65,\n          \"intel_ark_tdp_w\": 54,\n          \"intel_thermal_solution_spec_w\": 65,\n          \"integrated_graphics\": \"UHD Graphics 630\"\n        },\n        \"other_standard_non_T_options\": {\n          \"dell_datasheet_rating_w\": 65\n        },\n        \"service_manual_processor_list_value_w\": 35\n      },\n      \"unit\": \"W\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.spec_sheet\",\n        \"src.intel.g5400\",\n        \"src.intel.g5500\",\n        \"src.dell.5060.service\"\n      ],\n      \"notes\": \"Source values are intentionally kept side by side rather than collapsed. The Dell service manual's 35 W processor paragraph is inconsistent with its data sheet's standard non-T versus T-suffix distinction; do not infer an installed CPU or use these figures as a measured system thermal limit.\"\n    },\n    {\n      \"id\": \"claim.fasteners.optional_mounting\",\n      \"subject_id\": \"pc.dell.optiplex-5060-tower.family\",\n      \"predicate\": \"optional_module_fastener_schedule\",\n      \"value\": [\n        {\n          \"assembly\": \"SD card reader\",\n          \"screw_type\": \"#6-32×3.6\",\n          \"quantity\": 1\n        },\n        {\n          \"assembly\": \"WLAN module\",\n          \"screw_type\": \"M2×3.5\",\n          \"quantity\": 1\n        },\n        {\n          \"assembly\": \"M.2 PCIe SSD\",\n          \"screw_type\": \"M2×3.5\",\n          \"quantity\": 1\n        },\n        {\n          \"assembly\": \"Type-C with DP/HDMI/VGA cable module\",\n          \"screw_type\": \"M3×3\",\n          \"quantity\": 2\n        },\n        {\n          \"assembly\": \"Internal antenna\",\n          \"screw_type\": \"M3×3\",\n          \"quantity\": 2\n        }\n      ],\n      \"unit\": \"fasteners\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.screw_table\"\n      ],\n      \"notes\": \"Optional hardware schedule from Dell's Tower screw table. These are conditional fastener references, not evidence that all options are simultaneously installed. The seven references are excluded from the 24 illustrative service-relevant physical screw/grommet instances.\"\n    },\n    {\n      \"id\": \"claim.storage.drive35_mechanism\",\n      \"subject_id\": \"storage.drive35.carrier.optional\",\n      \"predicate\": \"drive_carrier_retention\",\n      \"value\": {\n        \"release\": \"single blue carrier tab\",\n        \"bracket\": \"removable HDD filler bracket\",\n        \"drive_retention\": \"flexible bracket pins engage drive slots\",\n        \"cable_disconnect\": [\n          \"SATA data\",\n          \"power\"\n        ]\n      },\n      \"unit\": \"service_configuration\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.hdd35_assembly\",\n        \"src.dell.5060.hdd35_bracket\"\n      ],\n      \"notes\": \"Optional 3.5-inch assembly; no fitted HDD or carrier variant is asserted.\"\n    },\n    {\n      \"id\": \"claim.storage.drive25_mechanism\",\n      \"subject_id\": \"storage.drive25.carrier.optional\",\n      \"predicate\": \"drive_carrier_retention\",\n      \"value\": {\n        \"release\": \"two blue side tabs\",\n        \"bracket\": \"flexible bracket pins engage drive slots\",\n        \"drive_retention\": \"pin-retained, not a universal screw pattern\",\n        \"cable_disconnect\": [\n          \"data\",\n          \"power\"\n        ]\n      },\n      \"unit\": \"service_configuration\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.hdd25_assembly\",\n        \"src.dell.5060.hdd25_bracket\"\n      ],\n      \"notes\": \"Optional 2.5-inch assembly; no fitted HDD or carrier variant is asserted.\"\n    },\n    {\n      \"id\": \"claim.storage.odd_mechanism\",\n      \"subject_id\": \"storage.optical_drive.optional\",\n      \"predicate\": \"optical_drive_release_and_cable_path\",\n      \"value\": {\n        \"release\": \"single blue carrier tab\",\n        \"cable_disconnect\": [\n          \"data\",\n          \"power\"\n        ],\n        \"cable_management\": \"unroute leads from tabs below the drive cage before disconnecting\"\n      },\n      \"unit\": \"service_configuration\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.odd_removal\"\n      ],\n      \"notes\": \"Optional slim optical drive; its installed presence is unknown.\"\n    },\n    {\n      \"id\": \"claim.ports.front_standard_external_connectors\",\n      \"subject_id\": \"front.io_region\",\n      \"predicate\": \"front_standard_external_connector_count\",\n      \"value\": 5,\n      \"unit\": \"ports\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.ports\",\n        \"src.dell.5060.front_view\"\n      ],\n      \"notes\": \"Five standard front connectors: one universal headset/audio jack and four USB ports. Optional SD reader and optical drive excluded.\"\n    },\n    {\n      \"id\": \"claim.ports.rear_standard_external_connectors\",\n      \"subject_id\": \"rear.io_region\",\n      \"predicate\": \"rear_standard_data_audio_network_connector_count\",\n      \"value\": 10,\n      \"unit\": \"ports\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.ports\",\n        \"src.dell.5060.back_view\"\n      ],\n      \"notes\": \"Ten standard rear data/audio/network connectors: one line-out, two DisplayPorts, four USB 3.1 Gen 1, two USB 2.0 SmartPower On and one RJ-45. AC inlet separate; serial, third-video and antenna modules optional.\"\n    }\n  ]\n}\n","process_layers.json":"{\n  \"schema_version\": \"0.1.0\",\n  \"device_model_id\": \"pc.dell.optiplex-5060-tower.family\",\n  \"process_layers\": [\n    {\n      \"id\": \"process.cooling\",\n      \"type\": \"cooling\",\n      \"title\": {\n        \"en\": \"CPU and chassis cooling\",\n        \"ru\": \"Охлаждение CPU и корпуса\"\n      },\n      \"mode\": \"qualitative\",\n      \"linked_component_ids\": [\n        \"cooling.assembly\",\n        \"cooling.cpu.heatsink\",\n        \"cooling.cpu.fan\",\n        \"cooling.system_fan\",\n        \"motherboard.cpu_socket\",\n        \"chassis.frame\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.service\"\n      ],\n      \"assumptions\": [\n        \"Positions and airflow are schematic. No CFD or measured temperature is represented.\"\n      ]\n    },\n    {\n      \"id\": \"process.power\",\n      \"type\": \"power_delivery\",\n      \"title\": {\n        \"en\": \"Power supply and board power\",\n        \"ru\": \"Блок питания и питание платы\"\n      },\n      \"mode\": \"qualitative\",\n      \"linked_component_ids\": [\n        \"power.assembly\",\n        \"power.psu\",\n        \"power.psu.fan\",\n        \"power.psu.harness\",\n        \"motherboard.system_power\",\n        \"motherboard.cpu_power\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.service\"\n      ],\n      \"assumptions\": [\n        \"No PSU internal topology, wattage, verified pinout or electrical simulation is claimed.\"\n      ]\n    },\n    {\n      \"id\": \"process.memory\",\n      \"type\": \"memory_topology\",\n      \"title\": {\n        \"en\": \"Memory subsystem · four UDIMM sockets\",\n        \"ru\": \"Подсистема памяти · четыре разъёма UDIMM\"\n      },\n      \"mode\": \"qualitative\",\n      \"linked_component_ids\": [\n        \"motherboard.pcb\",\n        \"motherboard.dimm.1\",\n        \"motherboard.dimm.2\",\n        \"motherboard.dimm.3\",\n        \"motherboard.dimm.4\",\n        \"motherboard.cpu_socket\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.memory\",\n        \"src.dell.5060.boardlayout\"\n      ],\n      \"assumptions\": [\n        \"Shows supported socket count and memory capability only; no channel routing, rank layout, installed DIMMs or timing training is simulated.\"\n      ]\n    },\n    {\n      \"id\": \"process.storage\",\n      \"type\": \"storage_topology\",\n      \"title\": {\n        \"en\": \"Storage interfaces · SATA and M.2\",\n        \"ru\": \"Интерфейсы накопителей · SATA и M.2\"\n      },\n      \"mode\": \"qualitative\",\n      \"linked_component_ids\": [\n        \"motherboard.sata.1\",\n        \"motherboard.sata.2\",\n        \"motherboard.sata.3\",\n        \"motherboard.sata.4\",\n        \"motherboard.sata_power_header\",\n        \"motherboard.m2\",\n        \"motherboard.m2.wlan\",\n        \"storage.assembly\",\n        \"storage.drive_cage\",\n        \"storage.drive25.optional\",\n        \"storage.drive35.optional\",\n        \"storage.m2.optional\",\n        \"storage.optical_drive.optional\",\n        \"storage.drive35.carrier.optional\",\n        \"storage.drive35.filler_bracket.optional\",\n        \"storage.drive35.drive_bracket.optional\",\n        \"storage.drive35.release_tab.optional\",\n        \"storage.drive25.carrier.optional\",\n        \"storage.drive25.drive_bracket.optional\",\n        \"storage.drive25.release_tab.left.optional\",\n        \"storage.drive25.release_tab.right.optional\",\n        \"storage.optical_drive.release_tab.optional\",\n        \"storage.drive_cage.cable_retention_tabs\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.storage\",\n        \"src.dell.5060.board_connectors\"\n      ],\n      \"assumptions\": [\n        \"Connection capabilities are documented; actual cable routes, drive population, BIOS settings and storage performance are unknown.\"\n      ]\n    },\n    {\n      \"id\": \"process.pcie\",\n      \"type\": \"pcie_expansion\",\n      \"title\": {\n        \"en\": \"PCIe expansion topology\",\n        \"ru\": \"Топология расширения PCIe\"\n      },\n      \"mode\": \"qualitative\",\n      \"linked_component_ids\": [\n        \"motherboard.pcie.x16\",\n        \"motherboard.pcie.x1.1\",\n        \"motherboard.pcie.x1.2\",\n        \"motherboard.pcie.x16.wired_x4\",\n        \"rear.expansion_opening.1\",\n        \"rear.expansion_opening.2\",\n        \"rear.expansion_opening.3\",\n        \"rear.expansion_opening.4\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.boardlayout\",\n        \"src.dell.5060.board_connectors\"\n      ],\n      \"assumptions\": [\n        \"Slot size and electrical lane width follow Dell's specifications; no installed card, lane sharing, chipset routing or board trace geometry is represented.\"\n      ]\n    },\n    {\n      \"id\": \"process.external_io\",\n      \"type\": \"external_connectivity\",\n      \"title\": {\n        \"en\": \"Front and rear external connectivity\",\n        \"ru\": \"Внешние интерфейсы передней и задней панелей\"\n      },\n      \"mode\": \"qualitative\",\n      \"linked_component_ids\": [\n        \"front.io_region\",\n        \"front.audio_combo\",\n        \"front.usb2.powershare\",\n        \"front.usb2\",\n        \"front.usbc.gen2.powershare\",\n        \"front.usb3.gen1\",\n        \"rear.io_region\",\n        \"rear.line_out\",\n        \"rear.displayport.1\",\n        \"rear.displayport.2\",\n        \"rear.usb3.gen1.1\",\n        \"rear.usb3.gen1.2\",\n        \"rear.usb3.gen1.3\",\n        \"rear.usb3.gen1.4\",\n        \"rear.usb2.smartpoweron.1\",\n        \"rear.usb2.smartpoweron.2\",\n        \"rear.rj45\",\n        \"rear.video_module.optional\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.ports\",\n        \"src.dell.5060.boardlayout\"\n      ],\n      \"assumptions\": [\n        \"Port inventory is a static family-level description; data rates, active PHY paths, optional module population and live I/O are not simulated.\"\n      ]\n    }\n  ]\n}\n","assembly_steps.json":"{\n  \"schema_version\": \"0.1.0\",\n  \"device_model_id\": \"pc.dell.optiplex-5060-tower.family\",\n  \"steps\": [\n    {\n      \"id\": \"step.optiplex.remove-side-cover\",\n      \"sequence\": 1,\n      \"title\": {\n        \"en\": \"Remove the side cover\",\n        \"ru\": \"Снять боковую крышку\"\n      },\n      \"description\": {\n        \"en\": \"Remove the cover before service; disconnect AC power and peripherals before opening the chassis.\",\n        \"ru\": \"Снять крышку перед обслуживанием; отключить сетевое питание и периферию перед вскрытием.\"\n      },\n      \"component_ids\": [\n        \"chassis.side_panel\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Disconnect mains power and use ESD precautions.\",\n        \"ru\": \"Отключить сеть и соблюдать защиту от ЭСР.\"\n      },\n      \"prerequisite_step_ids\": [],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\"\n      ],\n      \"scene_actions\": [\n        {\n          \"type\": \"translate\",\n          \"target_component_ids\": [\n            \"chassis.side_panel\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"direction\": \"outward_from_case\",\n          \"distance_mode\": \"visual_clearance\",\n          \"note\": {\n            \"en\": \"Move the side-cover proxy away from the chassis. Travel is an illustrative clearance; Dell does not dimension the cover path.\",\n            \"ru\": \"Отвести условную боковую крышку от корпуса. Перемещение показывает только условный зазор; Dell не задаёт размер траектории.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-front-bezel\",\n      \"sequence\": 2,\n      \"title\": {\n        \"en\": \"Remove the front bezel\",\n        \"ru\": \"Снять переднюю декоративную панель\"\n      },\n      \"description\": {\n        \"en\": \"Remove the bezel as listed in Dell's system-board removal prerequisites.\",\n        \"ru\": \"Снять панель по перечню предварительных операций Dell.\"\n      },\n      \"component_ids\": [\n        \"chassis.front_panel\",\n        \"front.io_region\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Release the documented tabs; do not lever against port openings.\",\n        \"ru\": \"Освобождать фиксаторы; не использовать отверстия портов как рычаг.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-side-cover\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\"\n      ],\n      \"scene_actions\": [\n        {\n          \"type\": \"translate\",\n          \"target_component_ids\": [\n            \"chassis.front_panel\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"direction\": \"frontward\",\n          \"distance_mode\": \"visual_clearance\",\n          \"note\": {\n            \"en\": \"Move the combined bezel/door proxy forward. The model does not contain separate measured hinge geometry.\",\n            \"ru\": \"Выдвинуть условную объединённую панель вперёд. В модели нет отдельной измеренной геометрии петли дверцы.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.open-front-door\",\n      \"sequence\": 3,\n      \"title\": {\n        \"en\": \"Open the front panel door\",\n        \"ru\": \"Открыть дверцу передней панели\"\n      },\n      \"description\": {\n        \"en\": \"Open the front door as required by the board service procedure.\",\n        \"ru\": \"Открыть дверцу согласно процедуре обслуживания платы.\"\n      },\n      \"component_ids\": [\n        \"chassis.front_panel\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Do not force the hinge or latch.\",\n        \"ru\": \"Не прикладывать силу к петле или защёлке.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-front-bezel\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\"\n      ],\n      \"scene_actions\": [\n        {\n          \"type\": \"select\",\n          \"target_component_ids\": [\n            \"chassis.front_panel\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"note\": {\n            \"en\": \"The family proxy combines the bezel and door; no hinge axis or opening angle is claimed.\",\n            \"ru\": \"Условная модель объединяет панель и дверцу; ось петли и угол открытия не заявляются.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-cpu-fan\",\n      \"sequence\": 4,\n      \"title\": {\n        \"en\": \"Remove the CPU heatsink fan\",\n        \"ru\": \"Снять вентилятор радиатора CPU\"\n      },\n      \"description\": {\n        \"en\": \"Remove the fan before the heatsink; Dell lists this among board-removal prerequisites.\",\n        \"ru\": \"Перед радиатором снять вентилятор; Dell включает это в подготовку к снятию платы.\"\n      },\n      \"component_ids\": [\n        \"cooling.cpu.fan\",\n        \"cooling.assembly\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Disconnect by the connector body, not by the wire.\",\n        \"ru\": \"Отсоединять за корпус разъёма, не тянуть за провод.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.open-front-door\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\",\n        \"src.dell.5060.boardlayout\"\n      ],\n      \"scene_actions\": [\n        {\n          \"type\": \"translate\",\n          \"target_component_ids\": [\n            \"cooling.cpu.fan\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"direction\": \"up\",\n          \"distance_mode\": \"visual_clearance\",\n          \"note\": {\n            \"en\": \"Lift the fan proxy clear of the heatsink. The path is illustrative, not a measured removal distance.\",\n            \"ru\": \"Приподнять условный вентилятор над радиатором. Траектория иллюстративная, не измеренная.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-heatsink\",\n      \"sequence\": 5,\n      \"title\": {\n        \"en\": \"Loosen four captive heatsink screws and lift the heatsink\",\n        \"ru\": \"Ослабить четыре невыпадающих винта и снять радиатор\"\n      },\n      \"description\": {\n        \"en\": \"Loosen the four captive screws in Dell's 1–4 order, then lift the heatsink. Coordinates and torque are not published.\",\n        \"ru\": \"Ослабить четыре винта в порядке Dell 1–4 и снять радиатор. Координаты и момент затяжки не опубликованы.\"\n      },\n      \"component_ids\": [\n        \"cooling.cpu.heatsink\",\n        \"fastener.cooler.captive.01\",\n        \"fastener.cooler.captive.02\",\n        \"fastener.cooler.captive.03\",\n        \"fastener.cooler.captive.04\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Support the heatsink as the last fastener is released.\",\n        \"ru\": \"Поддерживать радиатор при освобождении последнего винта.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-cpu-fan\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.heatsink\"\n      ],\n      \"scene_actions\": [\n        {\n          \"type\": \"hide\",\n          \"target_component_ids\": [\n            \"fastener.cooler.captive.01\",\n            \"fastener.cooler.captive.02\",\n            \"fastener.cooler.captive.03\",\n            \"fastener.cooler.captive.04\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"note\": {\n            \"en\": \"Hide the four captive screw proxies in Dell's documented 1–4 release order.\",\n            \"ru\": \"Убрать четыре условных винта в документированном Dell порядке ослабления 1–4.\"\n          }\n        },\n        {\n          \"type\": \"translate\",\n          \"target_component_ids\": [\n            \"cooling.cpu.heatsink\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"direction\": \"up\",\n          \"distance_mode\": \"visual_clearance\",\n          \"note\": {\n            \"en\": \"Lift the heatsink proxy after releasing the four captive screws. The clearance is illustrative.\",\n            \"ru\": \"Поднять условный радиатор после ослабления четырёх невыпадающих винтов. Зазор условный.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-processor\",\n      \"sequence\": 6,\n      \"title\": {\n        \"en\": \"Release and remove the processor\",\n        \"ru\": \"Освободить и извлечь процессор\"\n      },\n      \"description\": {\n        \"en\": \"After heatsink removal, release the socket lever and processor cover as Dell describes, then lift the CPU out.\",\n        \"ru\": \"После снятия радиатора освободить рычаг сокета и крышку процессора по инструкции Dell, затем извлечь CPU.\"\n      },\n      \"component_ids\": [\n        \"motherboard.cpu_socket\",\n        \"motherboard.pcb\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"LGA contacts are fragile. Hold the CPU by its edges.\",\n        \"ru\": \"Контакты LGA хрупкие. Держать CPU за края.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-heatsink\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.cpu_removal\"\n      ],\n      \"scene_actions\": [\n        {\n          \"type\": \"select\",\n          \"target_component_ids\": [\n            \"motherboard.cpu_socket\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"note\": {\n            \"en\": \"The launch-family scene models the socket, not a fitted CPU package or its retention mechanism; no processor mesh is removed.\",\n            \"ru\": \"Сцена семейства показывает сокет, но не установленный CPU и не механизм фиксации; отдельная модель процессора не извлекается.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-expansion-cards\",\n      \"sequence\": 7,\n      \"title\": {\n        \"en\": \"Remove installed expansion cards, if present\",\n        \"ru\": \"Снять установленные платы расширения, если они есть\"\n      },\n      \"description\": {\n        \"en\": \"Remove any fitted expansion cards. Empty slots remain empty; no GPU installation is implied.\",\n        \"ru\": \"Снять установленные платы расширения. Пустые слоты остаются пустыми; наличие GPU не подразумевается.\"\n      },\n      \"component_ids\": [\n        \"motherboard.pcie.x16\",\n        \"motherboard.pcie.x1.1\",\n        \"motherboard.pcie.x1.2\",\n        \"motherboard.pcie.x16.wired_x4\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Release the bracket retainer and slot latch; support the card.\",\n        \"ru\": \"Освободить фиксатор планки и слота; поддерживать плату.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-processor\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\"\n      ],\n      \"scene_actions\": [\n        {\n          \"type\": \"conditional\",\n          \"target_component_ids\": [\n            \"motherboard.pcie.x16\",\n            \"motherboard.pcie.x1.1\",\n            \"motherboard.pcie.x1.2\",\n            \"motherboard.pcie.x16.wired_x4\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"condition\": \"fitted_expansion_card\",\n          \"note\": {\n            \"en\": \"Conditional step: the family reference does not assert that an expansion card is installed, so no card is fabricated or hidden.\",\n            \"ru\": \"Условный шаг: эталон семейства не подтверждает установленную плату расширения; отсутствующая карта не дорисовывается и не скрывается.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-pcie-ssd\",\n      \"sequence\": 8,\n      \"title\": {\n        \"en\": \"Remove a PCIe SSD, if fitted\",\n        \"ru\": \"Снять PCIe SSD, если он установлен\"\n      },\n      \"description\": {\n        \"en\": \"Remove the PCIe SSD only if fitted; Dell lists it as a prerequisite but the family package does not assert an installed drive.\",\n        \"ru\": \"Снимать PCIe SSD только при наличии; Dell перечисляет этап, но пакет семейства не утверждает наличие диска.\"\n      },\n      \"component_ids\": [\n        \"motherboard.m2\",\n        \"storage.m2.optional\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Retain the SSD screw and spacer if present.\",\n        \"ru\": \"Сохранить винт и стойку SSD, если они есть.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-expansion-cards\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\",\n        \"src.dell.5060.storage\"\n      ],\n      \"scene_actions\": [\n        {\n          \"type\": \"conditional\",\n          \"target_component_ids\": [\n            \"storage.m2.optional\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"condition\": \"m2_ssd_fitted\",\n          \"note\": {\n            \"en\": \"No M.2 SSD is populated in this family reference. The socket remains visible and no drive is invented.\",\n            \"ru\": \"В эталоне семейства SSD M.2 не установлен. Разъём остаётся видимым; накопитель не дорисовывается.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-sd-reader\",\n      \"sequence\": 9,\n      \"title\": {\n        \"en\": \"Remove the optional SD reader, if fitted\",\n        \"ru\": \"Снять картридер SD, если он установлен\"\n      },\n      \"description\": {\n        \"en\": \"Remove the optional SD reader only if present; Dell shows its board connector and lists module removal before board extraction.\",\n        \"ru\": \"Снимать картридер SD только при наличии; Dell показывает разъём платы и перечисляет снятие модуля до извлечения платы.\"\n      },\n      \"component_ids\": [\n        \"storage.sd_reader.optional\",\n        \"motherboard.sd_reader_header\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"A board header alone does not prove a reader is fitted.\",\n        \"ru\": \"Наличие разъёма не доказывает, что картридер установлен.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-pcie-ssd\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\",\n        \"src.dell.5060.boardlayout\"\n      ],\n      \"scene_actions\": [\n        {\n          \"type\": \"conditional\",\n          \"target_component_ids\": [\n            \"storage.sd_reader.optional\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"condition\": \"sd_reader_fitted\",\n          \"note\": {\n            \"en\": \"The SD reader is optional and not populated in the reference configuration.\",\n            \"ru\": \"Картридер SD является опцией и отсутствует в эталонной конфигурации.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-memory\",\n      \"sequence\": 10,\n      \"title\": {\n        \"en\": \"Remove installed memory modules\",\n        \"ru\": \"Извлечь установленные модули памяти\"\n      },\n      \"description\": {\n        \"en\": \"Release the clips and remove installed DIMMs. Four sockets show capability, not fitted memory population.\",\n        \"ru\": \"Освободить фиксаторы и извлечь установленные DIMM. Четыре слота показывают поддержку, а не заполнение.\"\n      },\n      \"component_ids\": [\n        \"motherboard.dimm.1\",\n        \"motherboard.dimm.2\",\n        \"motherboard.dimm.3\",\n        \"motherboard.dimm.4\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Handle modules by their edges and use ESD-safe packaging.\",\n        \"ru\": \"Брать модули за края и использовать антистатическую упаковку.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-sd-reader\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\",\n        \"src.dell.5060.memory\"\n      ],\n      \"scene_actions\": [\n        {\n          \"type\": \"conditional\",\n          \"target_component_ids\": [\n            \"motherboard.dimm.1\",\n            \"motherboard.dimm.2\",\n            \"motherboard.dimm.3\",\n            \"motherboard.dimm.4\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"condition\": \"fitted_dimm_modules\",\n          \"note\": {\n            \"en\": \"The four sockets show supported positions, not installed DIMMs. The current scene contains no module geometry to remove.\",\n            \"ru\": \"Четыре слота показывают поддерживаемые позиции, а не установленные DIMM. В сцене нет геометрии модулей для извлечения.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.disconnect-board-cables\",\n      \"sequence\": 11,\n      \"title\": {\n        \"en\": \"Disconnect the system-board cables\",\n        \"ru\": \"Отсоединить кабели системной платы\"\n      },\n      \"description\": {\n        \"en\": \"Dell lists CPU power, HDD/ODD data, internal speaker, system power and SATA connections before board removal.\",\n        \"ru\": \"Dell предписывает отключить питание CPU, линии HDD/ODD, динамик, питание системы и кабели SATA перед снятием платы.\"\n      },\n      \"component_ids\": [\n        \"motherboard.cpu_power\",\n        \"motherboard.system_power\",\n        \"motherboard.sata_power_header\",\n        \"motherboard.sata.1\",\n        \"motherboard.sata.2\",\n        \"motherboard.sata.3\",\n        \"motherboard.sata.4\",\n        \"motherboard.speaker_header\",\n        \"front.speaker\",\n        \"power.psu.harness\",\n        \"storage.assembly\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Confirm AC is disconnected; pull connector bodies, not wires.\",\n        \"ru\": \"Убедиться, что сеть отключена; тянуть за корпуса разъёмов, не за провода.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-memory\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\",\n        \"src.dell.5060.boardlayout\"\n      ],\n      \"scene_actions\": [\n        {\n          \"type\": \"select\",\n          \"target_component_ids\": [\n            \"motherboard.cpu_power\",\n            \"motherboard.system_power\",\n            \"motherboard.sata.1\",\n            \"motherboard.sata.2\",\n            \"motherboard.sata.3\",\n            \"motherboard.sata.4\",\n            \"motherboard.speaker_header\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"note\": {\n            \"en\": \"Select the documented board headers. Individual cable harness paths are not modeled, so the viewer does not hide the soldered headers.\",\n            \"ru\": \"Выделить документированные разъёмы платы. Трассы отдельных жгутов не смоделированы, поэтому сами разъёмы на плате не скрываются.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-system-board\",\n      \"sequence\": 12,\n      \"title\": {\n        \"en\": \"Remove nine board screws and lift the system board out\",\n        \"ru\": \"Выкрутить девять винтов и извлечь системную плату\"\n      },\n      \"description\": {\n        \"en\": \"Remove the nine board-to-chassis screws listed by Dell, slide the board to disengage its locating features, then lift it out. Coordinates remain unknown.\",\n        \"ru\": \"Удалить девять винтов крепления платы, сдвинуть её для освобождения позиционирующих элементов и поднять. Координаты неизвестны.\"\n      },\n      \"component_ids\": [\n        \"motherboard.assembly\",\n        \"motherboard.pcb\",\n        \"fastener.motherboard.01\",\n        \"fastener.motherboard.02\",\n        \"fastener.motherboard.03\",\n        \"fastener.motherboard.04\",\n        \"fastener.motherboard.05\",\n        \"fastener.motherboard.06\",\n        \"fastener.motherboard.07\",\n        \"fastener.motherboard.08\",\n        \"fastener.motherboard.09\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Support the board with both hands; do not bend it.\",\n        \"ru\": \"Поддерживать плату двумя руками; не сгибать.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.disconnect-board-cables\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\",\n        \"src.dell.5060.screw_table\"\n      ],\n      \"scene_actions\": [\n        {\n          \"type\": \"hide\",\n          \"target_component_ids\": [\n            \"fastener.motherboard.01\",\n            \"fastener.motherboard.02\",\n            \"fastener.motherboard.03\",\n            \"fastener.motherboard.04\",\n            \"fastener.motherboard.05\",\n            \"fastener.motherboard.06\",\n            \"fastener.motherboard.07\",\n            \"fastener.motherboard.08\",\n            \"fastener.motherboard.09\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"note\": {\n            \"en\": \"Hide the nine schematic system-board screw proxies. Their individual positions and heads are not measured.\",\n            \"ru\": \"Убрать девять условных винтов системной платы. Их индивидуальные положения и головки не измерены.\"\n          }\n        },\n        {\n          \"type\": \"translate\",\n          \"target_component_ids\": [\n            \"motherboard.assembly\"\n          ],\n          \"evidence_class\": \"illustrative\",\n          \"direction\": \"up\",\n          \"distance_mode\": \"visual_clearance\",\n          \"note\": {\n            \"en\": \"Lift the board assembly clear of the chassis after releasing the screws. Dell does not specify a measured lift path.\",\n            \"ru\": \"Поднять сборку платы из корпуса после освобождения винтов. Dell не задаёт измеренную траекторию подъёма.\"\n          }\n        }\n      ]\n    }\n  ],\n  \"observations\": [\n    {\n      \"source_id\": \"src.dell.5060.service\",\n      \"locator\": \"Side-cover, PSU, system-board and cooling removal/installation sections\",\n      \"note\": {\n        \"en\": \"Dell publishes service procedures for these assemblies. The exact ordered disassembly sequence has not yet been authored into this family-level package.\",\n        \"ru\": \"Dell публикует процедуры обслуживания этих узлов. Полная последовательность разборки пока не перенесена в этот пакет семейства.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.service\",\n      \"locator\": \"Tower screw-size table and heatsink-fan procedure\",\n      \"note\": {\n        \"en\": \"The table lists 9 board screws and 3 PSU screws; it separately documents four captive heatsink screws and four heatsink-fan screws. Optional-module entries are configuration-dependent.\",\n        \"ru\": \"В таблице указаны 9 винтов платы и 3 винта БП; отдельно описаны четыре невыпадающих винта радиатора и четыре винта вентилятора. Крепёж опциональных модулей зависит от конфигурации.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.system_fan\",\n      \"locator\": \"Removing system fan\",\n      \"note\": {\n        \"en\": \"Dell instructs the technician to disconnect the intrusion-switch cable, unroute it from the grommet, disconnect the fan cable, stretch the rubber mounts and slide the fan out. The family package models four grommet instances but no exact fan coordinates.\",\n        \"ru\": \"Dell предписывает отключить кабель датчика вскрытия, освободить его из втулки, отключить кабель вентилятора, растянуть резиновые крепления и извлечь вентилятор. Пакет семейства содержит четыре экземпляра втулок, но не точные координаты вентилятора.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.psu_removal\",\n      \"locator\": \"Removing PSU\",\n      \"note\": {\n        \"en\": \"Separate PSU procedure: disconnect and unroute cables from retention clips, remove three PSU-to-chassis screws, press the chassis release tab and slide/lift the PSU out. This sequence is not conflated with system-board removal.\",\n        \"ru\": \"Отдельная процедура снятия БП: отключить и освободить кабели из фиксаторов, удалить три винта крепления БП к корпусу, нажать фиксатор корпуса и сдвинуть/поднять БП. Эта последовательность не смешивается со снятием системной платы.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.screw_table\",\n      \"locator\": \"Tower screw-size table\",\n      \"note\": {\n        \"en\": \"Dell lists nine #6-32 × 1.4 mm screws for the system board and three #6-32 × 1.4 mm screws for PSU-to-chassis mounting. Other listed quantities are optional/module-specific and must not be summed as a universal installed count.\",\n        \"ru\": \"Dell указывает девять винтов #6-32 × 1,4 мм для системной платы и три винта #6-32 × 1,4 мм для крепления БП к корпусу. Другие позиции таблицы относятся к опциям и модулям и не должны суммироваться как универсальное установленное количество.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.system_fan\",\n      \"locator\": \"Removing system fan\",\n      \"note\": {\n        \"en\": \"Dell instructs disconnecting the intrusion-switch cable, unrouting it from the grommet, disconnecting the fan cable, stretching the rubber mounts and sliding the fan out. Four grommets are represented; coordinates are not measured.\",\n        \"ru\": \"Dell предписывает отключить кабель датчика вскрытия, освободить его из втулки, отключить вентилятор, растянуть резиновые крепления и извлечь его. Представлены четыре втулки; координаты не измерены.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.psu_removal\",\n      \"locator\": \"Removing PSU\",\n      \"note\": {\n        \"en\": \"Separate procedure: disconnect/unroute cables, remove three PSU screws, press the chassis release tab and slide/lift the PSU out. Not part of board removal.\",\n        \"ru\": \"Отдельная процедура: отключить/освободить кабели, удалить три винта БП, нажать фиксатор корпуса и сдвинуть/поднять БП. Не часть снятия платы.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.screw_table\",\n      \"locator\": \"Tower screw-size table\",\n      \"note\": {\n        \"en\": \"Dell lists nine #6-32 × 1.4 mm system-board screws and three #6-32 × 1.4 mm PSU screws. Other entries are optional/module-specific, not a universal installed count.\",\n        \"ru\": \"Dell указывает девять винтов #6-32 × 1,4 мм системной платы и три винта #6-32 × 1,4 мм БП. Остальные позиции относятся к опциям/модулям, а не к универсальному установленному количеству.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.m2_removal\",\n      \"locator\": \"Removing M.2 SSD\",\n      \"note\": {\n        \"en\": \"If an M.2 PCIe SSD is fitted: remove its single M2×3.5 retaining screw and slide the module out of the system-board connector. The option is not populated in the family reference.\",\n        \"ru\": \"Если M.2 PCIe SSD установлен: выкрутить единственный крепёжный винт M2×3,5 и выдвинуть модуль из разъёма системной платы. В эталоне семейства опция не установлена.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.coin_cell_removal\",\n      \"locator\": \"Removing coin-cell battery\",\n      \"note\": {\n        \"en\": \"Press the coin-cell socket release latch until the battery pops out, then lift it from the holder. Dell notes that removing the coin cell may reset BIOS/settings.\",\n        \"ru\": \"Нажать фиксатор держателя батарейки, пока она не выйдет из гнезда, затем извлечь. Dell предупреждает, что снятие батарейки может сбросить BIOS/настройки.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.heatsink_fan_removal\",\n      \"locator\": \"Removing heat sink fan\",\n      \"note\": {\n        \"en\": \"Disconnect the heatsink assembly cable, remove the fan screws through the top screw holes and lift the fan away. Exact fan SKU and screw coordinates are unknown.\",\n        \"ru\": \"Отключить кабель сборки радиатора, выкрутить винты вентилятора через верхние отверстия и снять вентилятор. Точный SKU вентилятора и координаты винтов неизвестны.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.service\",\n      \"locator\": \"Removing 3.5-inch and 2.5-inch hard-drive assemblies, printed pp.22–27\",\n      \"note\": {\n        \"en\": \"The 3.5-inch assembly uses a removable HDD filler bracket and blue release tab; disconnect SATA data/power, press the tab and slide the assembly out. The 2.5-inch assembly is disconnected and released by blue tabs on both sides. Both drive brackets retain the drive with flexible pins rather than a universal fixed screw pattern.\",\n        \"ru\": \"Сборка 3,5″ использует съёмную заглушку/кронштейн HDD и синюю защёлку; после отключения SATA и питания нажать защёлку и выдвинуть сборку. Сборка 2,5″ отключается и освобождается синими фиксаторами по бокам. Оба кронштейна удерживают диск гибкими штифтами, а не универсальной схемой винтов.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.optical_drive_install\",\n      \"locator\": \"Installing optical drive\",\n      \"note\": {\n        \"en\": \"The optional slim optical drive slides into its bay until it clicks. Route the data/power leads under the drive cage and connect them to the drive.\",\n        \"ru\": \"Опциональный тонкий оптический привод вставляется в отсек до щелчка. Кабели данных/питания провести под корзиной накопителей и подключить к приводу.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.optional_video_module\",\n      \"locator\": \"Installing optional VGA module\",\n      \"note\": {\n        \"en\": \"Remove the rear metal blanking bracket, insert the optional video module from inside, connect its system-board cable and secure it with two M3×3 screws. This is an option-specific procedure.\",\n        \"ru\": \"Снять заднюю металлическую заглушку, вставить опциональный видеомодуль изнутри, подключить кабель к системной плате и закрепить двумя винтами M3×3. Процедура относится только к опциональной конфигурации.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.hdd35_assembly\",\n      \"locator\": \"Removing 3.5-inch hard-drive assembly\",\n      \"note\": {\n        \"en\": \"Disconnect SATA and power from the drive, remove the HDD filler bracket, press the blue tab and pull the carrier assembly out of the chassis.\",\n        \"ru\": \"Отключить SATA и питание от диска, снять заглушку HDD, нажать синюю защёлку и извлечь сборку-корзину из корпуса.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.hdd35_bracket\",\n      \"locator\": \"Removing 3.5-inch HDD from the drive bracket\",\n      \"note\": {\n        \"en\": \"Release the HDD from its carrier by pulling one side of the flexible bracket to disengage its pins from the drive slots, then lift the drive out.\",\n        \"ru\": \"Освободить HDD из корзины: оттянуть одну сторону гибкого кронштейна, вывести штифты из пазов диска и поднять накопитель.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.hdd25_assembly\",\n      \"locator\": \"Removing 2.5-inch hard-drive assembly\",\n      \"note\": {\n        \"en\": \"Disconnect data and power from the 2.5-inch drive, press blue tabs on both sides of the carrier and pull the assembly out of the chassis.\",\n        \"ru\": \"Отключить данные и питание от диска 2,5″, нажать синие защёлки с обеих сторон корзины и извлечь сборку из корпуса.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.hdd25_bracket\",\n      \"locator\": \"Removing 2.5-inch drive from its bracket\",\n      \"note\": {\n        \"en\": \"Pull one side of the flexible bracket to disengage the retaining pins from the drive slots, then lift the drive out.\",\n        \"ru\": \"Оттянуть одну сторону гибкого кронштейна, вывести удерживающие штифты из пазов диска и поднять накопитель.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.odd_removal\",\n      \"locator\": \"Removing optical drive\",\n      \"note\": {\n        \"en\": \"Disconnect data and power cables, freeing them from retention tabs beneath the drive cage if needed. Press the blue release tab and slide the slim optical drive out.\",\n        \"ru\": \"Отключить кабели данных и питания, при необходимости освободив их из фиксаторов под корзиной. Нажать синюю защёлку и выдвинуть тонкий оптический привод.\"\n      }\n    }\n  ],\n  \"status\": \"manufacturer_documented_partial_procedure\",\n  \"scope_note\": {\n    \"en\": \"The 12-step chain below is only Dell's system-board removal prerequisite sequence. Separate service procedures for M.2 SSD, coin cell, heatsink fan, HDD/ODD and optional video modules are recorded as independent observations below. Optional-device presence remains conditional; this package is not a complete teardown/reassembly guide.\",\n    \"ru\": \"12 шагов ниже описывают только последовательность снятия системной платы по Dell. Отдельные процедуры M.2 SSD, батарейки RTC, вентилятора радиатора, HDD/ODD и опционального видеомодуля записаны ниже как самостоятельные наблюдения. Наличие опций условно; пакет не является полной инструкцией разборки/сборки.\"\n  }\n}\n","learning.json":"{\n  \"schema_version\": \"0.1.0\",\n  \"device_model_id\": \"pc.dell.optiplex-5060-tower.family\",\n  \"questions\": [\n    {\n      \"id\": \"learn.optiplex.dimensions\",\n      \"prompt\": {\n        \"en\": \"Which are the published Tower dimensions?\",\n        \"ru\": \"Какие размеры Tower опубликованы Dell?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"350 × 154 × 274 mm\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"350 × 244 × 274 mm\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"154 × 154 × 274 mm\"\n        }\n      ],\n      \"correct_choice_id\": \"a\",\n      \"explanation\": {\n        \"en\": \"The family-level envelope is 350 mm high, 154 mm wide and 274 mm deep.\",\n        \"ru\": \"Габариты семейства: 350 мм высота, 154 мм ширина, 274 мм глубина.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.setup\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.fasteners\",\n      \"prompt\": {\n        \"en\": \"Does the screw-table sum of 19 prove that every retail configuration has exactly 19 screws installed?\",\n        \"ru\": \"Доказывает ли сумма 19 в таблице, что в каждой комплектации установлено ровно 19 винтов?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"Yes / Да\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"No; optional modules and configuration matter / Нет; важны опции и комплектация\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"The total includes optional and module-specific fasteners; it is not a universal installed count.\",\n        \"ru\": \"Сумма включает крепёж опциональных модулей и не является универсальным количеством установленных винтов.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.service\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.memory.capacity\",\n      \"prompt\": {\n        \"en\": \"How many UDIMM sockets and what maximum memory capacity does Dell specify?\",\n        \"ru\": \"Сколько разъёмов UDIMM и какой максимальный объём памяти указывает Dell?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"2 sockets / 32 GB\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"4 sockets / 64 GB\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"8 sockets / 128 GB\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"Dell specifies four UDIMM sockets and up to 64 GB total, with up to 16 GB per socket.\",\n        \"ru\": \"Dell указывает четыре разъёма UDIMM и до 64 ГБ суммарно, до 16 ГБ на разъём.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.memory\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.pcie.slots\",\n      \"prompt\": {\n        \"en\": \"Which PCIe slot has a mechanical x16 connector but is electrically wired for x4?\",\n        \"ru\": \"Какой слот PCIe имеет физический разъём x16, но электрически подключён как x4?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"Slot 2\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"Slot 1\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"Slot 4\"\n        }\n      ],\n      \"correct_choice_id\": \"c\",\n      \"explanation\": {\n        \"en\": \"Dell identifies Slot 4 as PCIe x16 mechanical with x4 electrical wiring, Revision 3.0.\",\n        \"ru\": \"Dell обозначает Slot 4 как механический PCIe x16 с электрическим подключением x4, Revision 3.0.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.boardlayout\",\n        \"src.dell.5060.board_connectors\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.sata.generations\",\n      \"prompt\": {\n        \"en\": \"How are the four SATA data headers divided by generation in Dell's connector specification?\",\n        \"ru\": \"Как по поколению распределены четыре SATA-разъёма в спецификации Dell?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"Four Gen3\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"One Gen2 and three Gen3\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"Two Gen2 and two Gen3\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"One SATA Gen2 header is assigned to the optical-drive path; the other three are Gen3.\",\n        \"ru\": \"Один разъём SATA Gen2 назначен для оптического привода; остальные три относятся к Gen3.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.board_connectors\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.m2.sockets\",\n      \"prompt\": {\n        \"en\": \"Does the platform use the same M.2 connector for SSD and WLAN?\",\n        \"ru\": \"Использует ли платформа один и тот же M.2-разъём для SSD и WLAN?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"Yes, one shared socket\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"No, separate SSD and WLAN sockets\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"No M.2 sockets are documented\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"Dell lists one M.2 SSD connector supporting 2230/2280 and a separate M.2 2230 WLAN connector.\",\n        \"ru\": \"Dell указывает один разъём M.2 SSD для 2230/2280 и отдельный разъём M.2 2230 для WLAN.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.board_connectors\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.psu.options\",\n      \"prompt\": {\n        \"en\": \"What power-supply options are listed for this Tower platform?\",\n        \"ru\": \"Какие варианты блока питания указаны для платформы Tower?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"180 W Bronze only\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"260 W Bronze or 260 W Platinum\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"500 W Gold only\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"The setup specification lists alternative 260 W EPA Bronze and 260 W EPA Platinum PSU configurations; the fitted option is unknown.\",\n        \"ru\": \"В спецификации указаны альтернативные варианты БП 260 Вт EPA Bronze и 260 Вт EPA Platinum; установленный вариант неизвестен.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.power\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.callouts\",\n      \"prompt\": {\n        \"en\": \"Does the 26-number motherboard illustration mean the board contains exactly 26 components?\",\n        \"ru\": \"Означает ли схема платы с 26 номерами, что на плате ровно 26 компонентов?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"Yes, each number is one discrete component\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"No, some numbers identify groups or connectors\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"It is the screw count\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"Callouts identify locations and functions; for example, one memory callout covers four physical DIMM sockets.\",\n        \"ru\": \"Номера обозначают позиции и функции; например, одна позиция памяти охватывает четыре физических слота DIMM.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.boardlayout\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.cpu.configuration\",\n      \"prompt\": {\n        \"en\": \"Does the family-level reference package identify the CPU fitted in an individual PC?\",\n        \"ru\": \"Определяет ли пакет семейства, какой процессор установлен в конкретном компьютере?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"Yes, it is always an i7-8700\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"No, it records supported options, not the fitted CPU\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"Yes, it is always an i5-8400\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"The package lists manufacturer-supported processor options but does not choose a factory configuration or physical sample.\",\n        \"ru\": \"Пакет перечисляет поддерживаемые производителем варианты процессоров, но не выбирает заводскую конфигурацию или физический экземпляр.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.processors\"\n      ]\n    }\n  ]\n}\n","animations.json":"{\n  \"schema_version\": \"0.1.0\",\n  \"device_model_id\": \"pc.dell.optiplex-5060-tower.family\",\n  \"status\": \"educational_clips_available\",\n  \"policy\": \"These clips animate only the published illustrative family proxy. Displacements are relative to the model's actual starting transforms; they are not measured service clearances, physical simulations or claims about optional installed hardware.\",\n  \"clips\": [\n    {\n      \"id\": \"clip.optiplex.side-cover-removal\",\n      \"title\": {\n        \"en\": \"Side-cover removal\",\n        \"ru\": \"Снятие боковой крышки\"\n      },\n      \"evidence_status\": \"educational_approximation\",\n      \"source_ids\": [\n        \"src.dell.5060.service\",\n        \"src.dell.5060.setup\"\n      ],\n      \"duration_ms\": 1000,\n      \"easing\": \"ease_in_out\",\n      \"description\": {\n        \"en\": \"The side-cover proxy moves outward from the chassis. The direction is a presentation cue; the actual extraction travel is not dimensioned.\",\n        \"ru\": \"Условная боковая крышка отводится от корпуса. Направление показывает действие; фактическое расстояние извлечения не указано.\"\n      },\n      \"tracks\": [\n        {\n          \"target_id\": \"chassis.side_panel\",\n          \"property\": \"position\",\n          \"relative\": true,\n          \"keyframes\": [\n            {\n              \"t\": 0,\n              \"value\": [\n                0,\n                0,\n                0\n              ]\n            },\n            {\n              \"t\": 1,\n              \"value\": [\n                110,\n                0,\n                0\n              ]\n            }\n          ],\n          \"coordinate_space\": \"world\"\n        }\n      ]\n    },\n    {\n      \"id\": \"clip.optiplex.cpu-cooling-removal\",\n      \"title\": {\n        \"en\": \"CPU cooling assembly lift\",\n        \"ru\": \"Подъём системы охлаждения CPU\"\n      },\n      \"evidence_status\": \"educational_approximation\",\n      \"source_ids\": [\n        \"src.dell.5060.heatsink\",\n        \"src.dell.5060.heatsink_fan_removal\"\n      ],\n      \"duration_ms\": 1400,\n      \"easing\": \"ease_in_out\",\n      \"description\": {\n        \"en\": \"The fan and heatsink proxies lift clear of the motherboard. This is a relative visual clearance, not a measured travel or complete service sequence.\",\n        \"ru\": \"Условные вентилятор и радиатор поднимаются над системной платой. Это относительный визуальный зазор, а не измеренное перемещение или полная сервисная последовательность.\"\n      },\n      \"tracks\": [\n        {\n          \"target_id\": \"cooling.cpu.fan\",\n          \"property\": \"position\",\n          \"relative\": true,\n          \"keyframes\": [\n            {\n              \"t\": 0,\n              \"value\": [\n                0,\n                0,\n                0\n              ]\n            },\n            {\n              \"t\": 1,\n              \"value\": [\n                0,\n                0,\n                42\n              ]\n            }\n          ],\n          \"coordinate_space\": \"world\"\n        },\n        {\n          \"target_id\": \"cooling.cpu.heatsink\",\n          \"property\": \"position\",\n          \"relative\": true,\n          \"keyframes\": [\n            {\n              \"t\": 0,\n              \"value\": [\n                0,\n                0,\n                0\n              ]\n            },\n            {\n              \"t\": 1,\n              \"value\": [\n                0,\n                0,\n                62\n              ]\n            }\n          ],\n          \"coordinate_space\": \"world\"\n        }\n      ]\n    },\n    {\n      \"id\": \"clip.optiplex.system-board-removal\",\n      \"title\": {\n        \"en\": \"System-board extraction\",\n        \"ru\": \"Извлечение системной платы\"\n      },\n      \"evidence_status\": \"educational_approximation\",\n      \"source_ids\": [\n        \"src.dell.5060.service\"\n      ],\n      \"duration_ms\": 1500,\n      \"easing\": \"ease_in_out\",\n      \"description\": {\n        \"en\": \"The board assembly lifts away after its fasteners are released. The lift path is a visual proxy; screw positions and clearance are not measured.\",\n        \"ru\": \"Сборка системной платы поднимается после освобождения крепежа. Траектория условная; положения винтов и зазор не измерены.\"\n      },\n      \"tracks\": [\n        {\n          \"target_id\": \"motherboard.assembly\",\n          \"property\": \"position\",\n          \"relative\": true,\n          \"keyframes\": [\n            {\n              \"t\": 0,\n              \"value\": [\n                0,\n                0,\n                0\n              ]\n            },\n            {\n              \"t\": 1,\n              \"value\": [\n                0,\n                0,\n                85\n              ]\n            }\n          ],\n          \"coordinate_space\": \"world\"\n        }\n      ]\n    }\n  ]\n}\n","release.json":"{\n  \"schema_version\": \"0.1.0\",\n  \"model_id\": \"pc.dell.optiplex-5060-tower.family\",\n  \"part_number\": null,\n  \"package_version\": \"0.4.0\",\n  \"status\": \"research_blockout\",\n  \"geometry_status\": \"illustrative_proxy_not_cad\",\n  \"identity_scope\": \"platform_family\",\n  \"file_count\": 10,\n  \"content_coverage\": {\n    \"motherboard_callouts\": 26,\n    \"semantic_components\": 137,\n    \"relationship_count\": 145,\n    \"process_layers\": 6,\n    \"assembly_steps\": 12,\n    \"learning_questions\": 9,\n    \"documented_source_records\": 28,\n    \"geometry_nodes\": 58,\n    \"optional_population_unknown\": true,\n    \"motherboard_callout_mappings\": 26,\n    \"technical_claims\": 34,\n    \"optional_fastener_references\": 7,\n    \"physical_fastener_instances\": 24,\n    \"service_observations\": 19,\n    \"storage_mechanism_nodes\": 10,\n    \"geometry_primitives\": {\n      \"box\": 52,\n      \"cylinder\": 2,\n      \"fan\": 3,\n      \"fin_stack\": 1,\n      \"total\": 58,\n      \"note\": \"Fan blade count and fin spacing are illustrative rendering choices, not sourced physical specifications.\"\n    }\n  }\n}\n","scene.glb":""}}