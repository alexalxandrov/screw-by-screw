,\n      \"parent_id\": \"rear.io_region\",\n      \"name\": {\n        \"en\": \"Service Tag label location\",\n        \"ru\": \"Место наклейки Service Tag\"\n      },\n      \"category\": \"identity_marker\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"logical_only\",\n      \"source_ids\": [\n        \"src.dell.5060.boardlayout\",\n        \"src.dell.5060.ports\",\n        \"src.dell.5060.back_view\"\n      ],\n      \"description\": {\n        \"en\": \"Service Tag location on the chassis. No real service-tag value is stored in this family package.\",\n        \"ru\": \"Место размещения Service Tag на корпусе. Реальное значение сервисного тега в пакете семейства не хранится.\"\n      }\n    },\n    {\n      \"id\": \"wireless.m2_module.optional\",\n      \"parent_id\": \"motherboard.pcb\",\n      \"name\": {\n        \"en\": \"Optional M.2 2230 WLAN module · not populated\",\n        \"ru\": \"Опциональный модуль M.2 2230 WLAN · не установлен\"\n      },\n      \"category\": \"wireless_device\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.board_connectors\",\n        \"src.dell.5060.storage\"\n      ],\n      \"description\": {\n        \"en\": \"Platform-supported WLAN module option in a separate M.2 2230 socket. No WLAN card, manufacturer, chipset or fitted antenna system is selected for this family reference.\",\n        \"ru\": \"Поддерживаемый платформой модуль WLAN в отдельном разъёме M.2 2230. Карта WLAN, производитель, чипсет и установленная антенная система не определены.\"\n      }\n    },\n    {\n      \"id\": \"rear.video_typec_module.optional\",\n      \"parent_id\": \"rear.io_region\",\n      \"name\": {\n        \"en\": \"Optional Type-C with DP/HDMI/VGA cable module · not populated\",\n        \"ru\": \"Опциональный кабельный модуль Type-C с DP/HDMI/VGA · не установлен\"\n      },\n      \"category\": \"external_io_module\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.screw_table\",\n        \"src.dell.5060.optional_video_module\",\n        \"src.dell.5060.back_view\"\n      ],\n      \"description\": {\n        \"en\": \"Dell's screw table lists a Type-C with DP/HDMI/VGA cable module secured by two M3×3 screws. Presence and exact port option remain unknown.\",\n        \"ru\": \"В таблице винтов Dell указан кабельный модуль Type-C с DP/HDMI/VGA, закрепляемый двумя винтами M3×3. Наличие и конкретный вариант неизвестны.\"\n      }\n    },\n    {\n      \"id\": \"wireless.antenna.internal.assembly\",\n      \"parent_id\": \"chassis.frame\",\n      \"name\": {\n        \"en\": \"Optional internal antenna assembly · not populated\",\n        \"ru\": \"Опциональная внутренняя антенная сборка · не установлена\"\n      },\n      \"category\": \"wireless_assembly\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.screw_table\"\n      ],\n      \"description\": {\n        \"en\": \"Dell lists two M3×3 screws for the internal antenna option. Antenna type, exact placement and fitted wireless module are unknown.\",\n        \"ru\": \"Dell указывает два винта M3×3 для опции внутренних антенн. Тип антенн, положение и установленный WLAN-модуль неизвестны.\"\n      }\n    },\n    {\n      \"id\": \"wireless.antenna.internal.1.optional\",\n      \"parent_id\": \"wireless.antenna.internal.assembly\",\n      \"name\": {\n        \"en\": \"Optional internal antenna 1 · not populated\",\n        \"ru\": \"Опциональная внутренняя антенна 1 · не установлена\"\n      },\n      \"category\": \"wireless_device\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.screw_table\"\n      ],\n      \"description\": {\n        \"en\": \"One internal antenna position represented by Dell's service hardware table; no antenna type or coordinate is assigned.\",\n        \"ru\": \"Одна из позиций внутренней антенны по сервисной таблице Dell; тип и координата не назначены.\"\n      }\n    },\n    {\n      \"id\": \"wireless.antenna.internal.2.optional\",\n      \"parent_id\": \"wireless.antenna.internal.assembly\",\n      \"name\": {\n        \"en\": \"Optional internal antenna 2 · not populated\",\n        \"ru\": \"Опциональная внутренняя антенна 2 · не установлена\"\n      },\n      \"category\": \"wireless_device\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.screw_table\"\n      ],\n      \"description\": {\n        \"en\": \"One internal antenna position represented by Dell's service hardware table; no antenna type or coordinate is assigned.\",\n        \"ru\": \"Одна из позиций внутренней антенны по сервисной таблице Dell; тип и координата не назначены.\"\n      }\n    },\n    {\n      \"id\": \"fastener.optional.sd_reader.01\",\n      \"parent_id\": \"storage.sd_reader.optional\",\n      \"name\": {\n        \"en\": \"SD-reader retaining screw · #6-32×3.6\",\n        \"ru\": \"Винт крепления картридера SD · #6-32×3,6\"\n      },\n      \"category\": \"fastener\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.screw_table\"\n      ],\n      \"description\": {\n        \"en\": \"One screw for the optional SD-card-reader module, per Dell's Tower screw-size table. This is a conditional reference, not a fitted instance.\",\n        \"ru\": \"Один винт опционального картридера SD по таблице крепежа Tower Dell. Это условная справочная позиция, не установленный экземпляр.\"\n      },\n      \"fastener_population\": \"optional_reference_not_fitted\",\n      \"hardware_specification\": {\n        \"thread\": \"#6-32\",\n        \"length_mm\": 3.6\n      }\n    },\n    {\n      \"id\": \"fastener.optional.wlan.01\",\n      \"parent_id\": \"wireless.m2_module.optional\",\n      \"name\": {\n        \"en\": \"WLAN retaining screw · M2×3.5\",\n        \"ru\": \"Винт крепления WLAN · M2×3,5\"\n      },\n      \"category\": \"fastener\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.screw_table\"\n      ],\n      \"description\": {\n        \"en\": \"One M2×3.5 screw for the optional WLAN module on the system board, per Dell's Tower screw-size table.\",\n        \"ru\": \"Один винт M2×3,5 для опционального модуля WLAN на системной плате по таблице крепежа Dell.\"\n      },\n      \"fastener_population\": \"optional_reference_not_fitted\",\n      \"hardware_specification\": {\n        \"thread\": \"M2\",\n        \"length_mm\": 3.5\n      }\n    },\n    {\n      \"id\": \"fastener.optional.m2ssd.01\",\n      \"parent_id\": \"storage.m2.optional\",\n      \"name\": {\n        \"en\": \"M.2 PCIe SSD retaining screw · M2×3.5\",\n        \"ru\": \"Винт крепления M.2 PCIe SSD · M2×3,5\"\n      },\n      \"category\": \"fastener\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.screw_table\"\n      ],\n      \"description\": {\n        \"en\": \"One M2×3.5 screw secures an optional M.2 PCIe SSD to the system board. Dell's removal procedure shows one screw and a slide-out action.\",\n        \"ru\": \"Один винт M2×3,5 крепит опциональный M.2 PCIe SSD к системной плате. Процедура Dell показывает один винт и извлечение сдвигом.\"\n      },\n      \"fastener_population\": \"optional_reference_not_fitted\",\n      \"hardware_specification\": {\n        \"thread\": \"M2\",\n        \"length_mm\": 3.5\n      }\n    },\n    {\n      \"id\": \"fastener.optional.typec.01\",\n      \"parent_id\": \"rear.video_typec_module.optional\",\n      \"name\": {\n        \"en\": \"Optional I/O module screw 1 · M3×3\",\n        \"ru\": \"Винт опционального I/O-модуля 1 · M3×3\"\n      },\n      \"category\": \"fastener\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.screw_table\"\n      ],\n      \"description\": {\n        \"en\": \"One of two M3×3 screws for the optional Type-C with DP/HDMI/VGA cable module.\",\n        \"ru\": \"Один из двух винтов M3×3 опционального кабельного модуля Type-C с DP/HDMI/VGA.\"\n      },\n      \"fastener_population\": \"optional_reference_not_fitted\",\n      \"hardware_specification\": {\n        \"thread\": \"M3\",\n        \"length_mm\": 3\n      }\n    },\n    {\n      \"id\": \"fastener.optional.typec.02\",\n      \"parent_id\": \"rear.video_typec_module.optional\",\n      \"name\": {\n        \"en\": \"Optional I/O module screw 2 · M3×3\",\n        \"ru\": \"Винт опционального I/O-модуля 2 · M3×3\"\n      },\n      \"category\": \"fastener\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.screw_table\"\n      ],\n      \"description\": {\n        \"en\": \"One of two M3×3 screws for the optional Type-C with DP/HDMI/VGA cable module.\",\n        \"ru\": \"Один из двух винтов M3×3 опционального кабельного модуля Type-C с DP/HDMI/VGA.\"\n      },\n      \"fastener_population\": \"optional_reference_not_fitted\",\n      \"hardware_specification\": {\n        \"thread\": \"M3\",\n        \"length_mm\": 3\n      }\n    },\n    {\n      \"id\": \"fastener.optional.antenna.01\",\n      \"parent_id\": \"wireless.antenna.internal.1.optional\",\n      \"name\": {\n        \"en\": \"Internal antenna retaining screw 1 · M3×3\",\n        \"ru\": \"Винт крепления внутренней антенны 1 · M3×3\"\n      },\n      \"category\": \"fastener\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.screw_table\"\n      ],\n      \"description\": {\n        \"en\": \"One of two M3×3 screws listed for the internal antenna option; bracket coordinates are unknown.\",\n        \"ru\": \"Один из двух винтов M3×3, указанных для опции внутренних антенн; координаты кронштейна неизвестны.\"\n      },\n      \"fastener_population\": \"optional_reference_not_fitted\",\n      \"hardware_specification\": {\n        \"thread\": \"M3\",\n        \"length_mm\": 3\n      }\n    },\n    {\n      \"id\": \"fastener.optional.antenna.02\",\n      \"parent_id\": \"wireless.antenna.internal.2.optional\",\n      \"name\": {\n        \"en\": \"Internal antenna retaining screw 2 · M3×3\",\n        \"ru\": \"Винт крепления внутренней антенны 2 · M3×3\"\n      },\n      \"category\": \"fastener\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.screw_table\"\n      ],\n      \"description\": {\n        \"en\": \"One of two M3×3 screws listed for the internal antenna option; bracket coordinates are unknown.\",\n        \"ru\": \"Один из двух винтов M3×3, указанных для опции внутренних антенн; координаты кронштейна неизвестны.\"\n      },\n      \"fastener_population\": \"optional_reference_not_fitted\",\n      \"hardware_specification\": {\n        \"thread\": \"M3\",\n        \"length_mm\": 3\n      }\n    },\n    {\n      \"id\": \"storage.drive35.carrier.optional\",\n      \"parent_id\": \"storage.assembly\",\n      \"name\": {\n        \"en\": \"Optional 3.5-inch HDD carrier assembly · not populated\",\n        \"ru\": \"Опциональная сборка-корзина HDD 3,5″ · не установлена\"\n      },\n      \"category\": \"storage_carrier\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.hdd35_assembly\",\n        \"src.dell.5060.service\"\n      ],\n      \"description\": {\n        \"en\": \"Dell documents a removable 3.5-inch HDD assembly with an HDD filler bracket and a blue release tab. Carrier revision, fitted drive and exact coordinates are unknown.\",\n        \"ru\": \"Dell документирует съёмную сборку HDD 3,5″ с заглушкой HDD и синей защёлкой. Ревизия корзины, установленный диск и точные координаты неизвестны.\"\n      },\n      \"population\": \"optional_not_fitted\"\n    },\n    {\n      \"id\": \"storage.drive35.filler_bracket.optional\",\n      \"parent_id\": \"storage.drive35.carrier.optional\",\n      \"name\": {\n        \"en\": \"Optional 3.5-inch HDD filler bracket · not populated\",\n        \"ru\": \"Опциональная заглушка HDD 3,5″ · не установлена\"\n      },\n      \"category\": \"storage_bracket\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.hdd35_assembly\"\n      ],\n      \"description\": {\n        \"en\": \"Dell's 3.5-inch assembly removal procedure requires removing the HDD filler bracket before releasing the carrier. Shape and dimensions are not measured.\",\n        \"ru\": \"По процедуре Dell перед освобождением корзины 3,5″ требуется снять заглушку HDD. Форма и размеры не измерены.\"\n      },\n      \"population\": \"optional_not_fitted\"\n    },\n    {\n      \"id\": \"storage.drive35.drive_bracket.optional\",\n      \"parent_id\": \"storage.drive35.carrier.optional\",\n      \"name\": {\n        \"en\": \"Optional 3.5-inch drive bracket · pin-retained\",\n        \"ru\": \"Опциональный кронштейн диска 3,5″ · фиксация штифтами\"\n      },\n      \"category\": \"storage_bracket\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.hdd35_bracket\"\n      ],\n      \"description\": {\n        \"en\": \"Dell documents flexible bracket pins that engage the drive slots; release one side of the bracket and lift the drive out. No fixed screw pattern is claimed.\",\n        \"ru\": \"Dell документирует гибкие штифты кронштейна, входящие в пазы диска; одну сторону кронштейна оттягивают и извлекают диск. Универсальная схема винтов не заявляется.\"\n      },\n      \"population\": \"optional_not_fitted\"\n    },\n    {\n      \"id\": \"storage.drive35.release_tab.optional\",\n      \"parent_id\": \"storage.drive35.carrier.optional\",\n      \"name\": {\n        \"en\": \"3.5-inch HDD carrier blue release tab · optional\",\n        \"ru\": \"Синяя защёлка корзины HDD 3,5″ · опционально\"\n      },\n      \"category\": \"mechanical_latch\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.hdd35_assembly\"\n      ],\n      \"description\": {\n        \"en\": \"Dell identifies a blue tab that releases the 3.5-inch carrier from the chassis.\",\n        \"ru\": \"Dell обозначает синюю защёлку, освобождающую корзину 3,5″ из корпуса.\"\n      },\n      \"population\": \"optional_not_fitted\"\n    },\n    {\n      \"id\": \"storage.drive25.carrier.optional\",\n      \"parent_id\": \"storage.assembly\",\n      \"name\": {\n        \"en\": \"Optional 2.5-inch HDD carrier assembly · not populated\",\n        \"ru\": \"Опциональная сборка-корзина HDD 2,5″ · не установлена\"\n      },\n      \"category\": \"storage_carrier\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.hdd25_assembly\",\n        \"src.dell.5060.service\"\n      ],\n      \"description\": {\n        \"en\": \"Dell documents a separate 2.5-inch hard-drive assembly released by blue tabs on both sides after disconnecting drive data and power. Exact carrier revision and position are unknown.\",\n        \"ru\": \"Dell документирует отдельную сборку HDD 2,5″, освобождаемую синими защёлками с обеих сторон после отключения питания и данных. Ревизия и положение корзины неизвестны.\"\n      },\n      \"population\": \"optional_not_fitted\"\n    },\n    {\n      \"id\": \"storage.drive25.drive_bracket.optional\",\n      \"parent_id\": \"storage.drive25.carrier.optional\",\n      \"name\": {\n        \"en\": \"Optional 2.5-inch drive bracket · pin-retained\",\n        \"ru\": \"Опциональный кронштейн диска 2,5″ · фиксация штифтами\"\n      },\n      \"category\": \"storage_bracket\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.hdd25_bracket\"\n      ],\n      \"description\": {\n        \"en\": \"Dell documents pins on the sides of the flexible bracket engaging drive slots. Pull one side of the bracket outward, disengage the pins and lift the drive.\",\n        \"ru\": \"Dell документирует боковые штифты гибкого кронштейна, входящие в пазы диска. Одну сторону кронштейна оттягивают, освобождают штифты и поднимают диск.\"\n      },\n      \"population\": \"optional_not_fitted\"\n    },\n    {\n      \"id\": \"storage.drive25.release_tab.left.optional\",\n      \"parent_id\": \"storage.drive25.carrier.optional\",\n      \"name\": {\n        \"en\": \"2.5-inch HDD carrier left blue release tab · optional\",\n        \"ru\": \"Левая синяя защёлка корзины HDD 2,5″ · опционально\"\n      },\n      \"category\": \"mechanical_latch\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.hdd25_assembly\"\n      ],\n      \"description\": {\n        \"en\": \"One of two blue side tabs that release the 2.5-inch carrier from the chassis.\",\n        \"ru\": \"Одна из двух синих боковых защёлок, освобождающих корзину 2,5″ из корпуса.\"\n      },\n      \"population\": \"optional_not_fitted\"\n    },\n    {\n      \"id\": \"storage.drive25.release_tab.right.optional\",\n      \"parent_id\": \"storage.drive25.carrier.optional\",\n      \"name\": {\n        \"en\": \"2.5-inch HDD carrier right blue release tab · optional\",\n        \"ru\": \"Правая синяя защёлка корзины HDD 2,5″ · опционально\"\n      },\n      \"category\": \"mechanical_latch\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.hdd25_assembly\"\n      ],\n      \"description\": {\n        \"en\": \"One of two blue side tabs that release the 2.5-inch carrier from the chassis.\",\n        \"ru\": \"Одна из двух синих боковых защёлок, освобождающих корзину 2,5″ из корпуса.\"\n      },\n      \"population\": \"optional_not_fitted\"\n    },\n    {\n      \"id\": \"storage.optical_drive.release_tab.optional\",\n      \"parent_id\": \"storage.optical_drive.optional\",\n      \"name\": {\n        \"en\": \"Slim optical-drive blue release tab · optional\",\n        \"ru\": \"Синяя защёлка тонкого оптического привода · опционально\"\n      },\n      \"category\": \"mechanical_latch\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.odd_removal\"\n      ],\n      \"description\": {\n        \"en\": \"Dell documents pressing a blue release tab and sliding the slim optical drive out of its bay after disconnecting and unrouting data/power leads.\",\n        \"ru\": \"Dell документирует нажатие синей защёлки и извлечение тонкого оптического привода после отсоединения и освобождения кабелей данных/питания.\"\n      },\n      \"population\": \"optional_not_fitted\"\n    },\n    {\n      \"id\": \"storage.drive_cage.cable_retention_tabs\",\n      \"parent_id\": \"storage.drive_cage\",\n      \"name\": {\n        \"en\": \"Drive-cage cable-retention tabs\",\n        \"ru\": \"Фиксаторы кабелей под корзиной накопителей\"\n      },\n      \"category\": \"cable_management\",\n      \"evidence_status\": \"manufacturer_data\",\n      \"geometry_status\": \"unknown\",\n      \"source_ids\": [\n        \"src.dell.5060.odd_removal\",\n        \"src.dell.5060.optical_drive_install\"\n      ],\n      \"description\": {\n        \"en\": \"Dell notes that optical-drive data and power leads may need to be unrouted from tabs underneath the drive cage before disconnection.\",\n        \"ru\": \"Dell отмечает, что перед отключением кабели данных и питания оптического привода может потребоваться освободить из фиксаторов под корзиной накопителей.\"\n      },\n      \"population\": \"optional_not_fitted\"\n    }\n  ]\n}\n","sources.json":"{\n  \"schema_version\": \"0.1.0\",\n  \"device_model_id\": \"pc.dell.optiplex-5060-tower.family\",\n  \"sources\": [\n    {\n      \"id\": \"src.dell.5060.service\",\n      \"title\": \"Dell OptiPlex 5060 Tower Service Manual\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_manual\",\n      \"url\": \"https://dl.dell.com/topicspdf/optiplex-5060-desktop_service-manual8_en-us.pdf\",\n      \"locator\": \"Tower service manual: screw-size list p.15; Tower motherboard callouts p.16; HDD assemblies pp.22–27; optical drive pp.28–30; M.2 PCIe SSD pp.32–33; SD reader pp.34–35; optional VGA module pp.40–41; coin-cell battery pp.54–55; heatsink fan pp.56–57; system board pp.66–69.\",\n      \"notes\": \"Primary manufacturer service manual for the Tower. Page ranges refer to the manual's printed page labels. Some optional devices and all fitted populations remain configuration-dependent.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.setup\",\n      \"title\": \"Dell OptiPlex 5060 Tower support · Manuals and specifications\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_setup_guide\",\n      \"url\": \"https://www.dell.com/support/product-details/en-us/product/optiplex-5060-desktop/resources/manuals\",\n      \"locator\": \"Tower physical characteristics\",\n      \"notes\": \"Family-level chassis dimensions and mass. These values constrain the outer envelope, not internal component coordinates.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.boardlayout\",\n      \"title\": \"Dell OptiPlex 5060 Tower motherboard layout\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_manual_web\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/tower-motherboard-layout?guid=guid-fdd68959-9fc2-4808-921a-11d712a6b730&lang=en-us\",\n      \"locator\": \"Tower motherboard layout, numbered callouts 1–26\",\n      \"notes\": \"Official Dell board map. Callouts identify connector positions and expansion-slot functions; they do not establish a measured PCB coordinate system or installed optional modules.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.board_removal\",\n      \"title\": \"Dell OptiPlex 5060 Tower system board removal\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/Removing-system-board?guid=guid-4619c874-96c4-4bf3-9e6e-cdc300d69ca1&lang=en-us\",\n      \"locator\": \"Removing system board — prerequisite removal list, cable disconnection and board fasteners\",\n      \"notes\": \"Manufacturer sequence used for the partial board-removal workflow. Optional components are only removed when fitted; this is not a universal teardown of every possible configuration.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.processors\",\n      \"title\": \"Dell OptiPlex 5060 Tower processor specifications\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_setup_specification\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_setup_and_specs/processor?guid=guid-b6e22f5e-0a6e-434f-b097-e21f7ea9e9b4&lang=en-us\",\n      \"locator\": \"Supported 8th-generation Intel processor option table\",\n      \"notes\": \"Supported CPU options only; no particular processor is asserted as installed. A service-manual processor table differs on some thermal-power values, so the package records the setup/specification table and flags this source discrepancy.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.memory\",\n      \"title\": \"Dell OptiPlex 5060 Tower memory specifications\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_setup_specification\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_setup_and_specs/memory?guid=guid-18225fae-5925-40fc-b98e-a33786b03be1&lang=en-us\",\n      \"locator\": \"Memory type, speed, slot count and maximum capacity\",\n      \"notes\": \"Manufacturer platform capability; fitted DIMM count, capacity and part numbers remain unknown.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.storage\",\n      \"title\": \"Dell OptiPlex 5060 Tower storage specifications\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_setup_specification\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_setup_and_specs/storage?guid=guid-9f98af2f-4c67-48fb-a236-8260a915d407&lang=en-us\",\n      \"locator\": \"M.2 SSD, SATA drive options, supported form factors and storage combinations\",\n      \"notes\": \"Supported storage configurations, not proof of installed drive population.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.board_connectors\",\n      \"title\": \"Dell OptiPlex 5060 Tower system-board connectors\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_setup_specification\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_setup_and_specs/system-board-connectors?guid=guid-c4437ab5-83cf-4c2e-a842-88de441bfc51&lang=en-us\",\n      \"locator\": \"M.2, SATA, PCIe and WLAN connector table\",\n      \"notes\": \"Manufacturer connector capability and generation information; no cable path or fitted-device state is implied.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.ports\",\n      \"title\": \"Dell OptiPlex 5060 Tower ports and connectors\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_setup_specification\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_setup_and_specs/ports-and-connectors?guid=guid-2f34b1fb-c81e-4e2c-9311-f801dd11fb9b&lang=en-us\",\n      \"locator\": \"Front and rear external ports and connector counts\",\n      \"notes\": \"External I/O support and count; optional module choices vary by order configuration.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.power\",\n      \"title\": \"Dell OptiPlex 5060 Tower power supply specifications\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_setup_specification\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_setup_and_specs/power-supply?guid=guid-d91d1b07-1ab0-4633-8dd8-9ef84459bf19&lang=en-us\",\n      \"locator\": \"260 W PSU variants and AC input characteristics\",\n      \"notes\": \"Two platform PSU variants are listed. The installed PSU manufacturer, Dell part number, efficiency option and revision remain unknown.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.screw_table\",\n      \"title\": \"Dell OptiPlex 5060 Tower screw-size list\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_manual_web\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/screw-size-list?guid=guid-a77fcea9-e6c9-4fd8-bc2b-2bedbc1f0d71&lang=en-us\",\n      \"locator\": \"Tower screw-size and quantity table\",\n      \"notes\": \"Documents listed screw types and quantities. Table sum must not be treated as installed screw count in every build.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.heatsink\",\n      \"title\": \"Dell OptiPlex 5060 Tower heatsink removal\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/removing-heat-sink?guid=guid-5187dca8-063c-4317-a83f-faeefbc6c82d&lang=en-us\",\n      \"locator\": \"Loosen four captive heatsink screws in the numbered 1–4 sequence\",\n      \"notes\": \"Supports the documented fastener group and screw-release order; no torque value or exact screw coordinates are stated.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.cpu_removal\",\n      \"title\": \"Dell OptiPlex 5060 Tower processor removal\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/removing-processor?guid=guid-2a1085f3-2318-4253-b9e1-61e799a99d84&lang=en-us\",\n      \"locator\": \"Release socket lever and processor cover after heatsink removal\",\n      \"notes\": \"Manufacturer warning about delicate socket contacts; no processor is selected for this family-level package.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.system_fan\",\n      \"title\": \"Dell OptiPlex 5060 Tower system fan removal\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/removing-system-fan?guid=guid-e43132eb-d02f-49d0-bb6e-2a1f13e8964b&lang=en-us\",\n      \"locator\": \"Disconnect intrusion-switch and fan cables; release rubber grommets\",\n      \"notes\": \"Documents fan cable routing through a mounting grommet and the elastomer mounting method. Exact grommet dimensions are not provided.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.psu_removal\",\n      \"title\": \"Dell OptiPlex 5060 Tower power supply removal\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/removing-power-supply-unit-or-psu?guid=guid-e09ec8ac-722e-477a-bcd8-a6fbc4b2f698&lang=en-us\",\n      \"locator\": \"Disconnect and unroute cables, release three PSU mounting screws and chassis tab\",\n      \"notes\": \"Manufacturer PSU removal procedure; model-specific cable routing and PSU part number are not captured by the family proxy.\",\n      \"access_date\": \"2026-11-26\"\n    },\n    {\n      \"id\": \"src.dell.5060.spec_sheet\",\n      \"title\": \"Dell OptiPlex 5060 technical specifications data sheet\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_technical_datasheet\",\n      \"url\": \"https://i.dell.com/sites/csdocuments/shared-content_data-sheets_documents/en/optiplex_5060_spec_sheet.pdf\",\n      \"locator\": \"Processor options; Tower I/O, storage, dimensions, weight, expansion slots and PSU rows\",\n      \"notes\": \"Combined Tower/SFF/Micro data sheet. Tower-specific chassis/ports/storage/PSU/slots use the Tower column; processor table includes standard and T-suffix options across form factors and must not be read as proof that every CPU fits every form factor.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.intel.g5400\",\n      \"title\": \"Intel Pentium Gold G5400 Processor Specifications\",\n      \"publisher\": \"Intel\",\n      \"source_type\": \"processor_manufacturer_product_specification\",\n      \"url\": \"https://www.intel.com/content/www/us/en/products/sku/129951/intel-pentium-gold-g5400-processor-4m-cache-3-70-ghz/specifications.html\",\n      \"locator\": \"CPU Specifications: 58 W TDP; GPU Specifications: UHD Graphics 610; Package Specifications: PCG 2015C (65 W)\",\n      \"notes\": \"Intel processor-level TDP and graphics identity. Thermal solution specification is a separate property and must not be conflated with TDP.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.intel.g5500\",\n      \"title\": \"Intel Pentium Gold G5500 Processor Specifications\",\n      \"publisher\": \"Intel\",\n      \"source_type\": \"processor_manufacturer_product_specification\",\n      \"url\": \"https://www.intel.com/content/www/us/en/products/sku/129946/intel-pentium-gold-g5500-processor-4m-cache-3-80-ghz/specifications.html\",\n      \"locator\": \"CPU Specifications: 54 W TDP; GPU Specifications: UHD Graphics 630; Package Specifications: PCG 2015C (65 W)\",\n      \"notes\": \"Intel processor-level TDP and graphics identity. Thermal solution specification is a separate property and must not be conflated with TDP.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.dell.5060.m2_removal\",\n      \"title\": \"Dell OptiPlex 5060 Tower removing M.2 SSD\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-ca/optiplex-5060-desktop/optiplex_5060_mt_service_manual/removing-m2-ssd?guid=guid-d1686d78-4afc-461e-b879-5fbf291e6aab&lang=en-us\",\n      \"locator\": \"Remove the single screw securing the SSD to the system board; slide SSD out of connector\",\n      \"notes\": \"Procedure is conditional on a fitted M.2 PCIe SSD; no installed drive or exact position is asserted by the family model.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.dell.5060.coin_cell_removal\",\n      \"title\": \"Dell OptiPlex 5060 Tower removing coin-cell battery\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-ca/optiplex-5060-desktop/optiplex_5060_mt_service_manual/removing-coin-cell-battery?guid=guid-25aeb843-7a64-40c7-985a-69e47c7c0b73&lang=en-us\",\n      \"locator\": \"Press battery-socket release latch; remove the coin-cell battery\",\n      \"notes\": \"Dell warns that battery removal may reset BIOS/settings. Fitted manufacturer and exact battery variant remain unknown.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.dell.5060.heatsink_fan_removal\",\n      \"title\": \"Dell OptiPlex 5060 Tower removing heatsink fan\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-in/optiplex-5060-desktop/optiplex_5060_mt_service_manual/removing-heat-sink-fan?guid=guid-e949c8bc-98ce-4dc8-adec-129c6ece95d7&lang=en-us\",\n      \"locator\": \"Disconnect heatsink assembly cable; remove fan screws through top screw holes; lift fan away\",\n      \"notes\": \"Exact fan part number and screw-head geometry are not identified by the family package.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.dell.5060.optical_drive_install\",\n      \"title\": \"Dell OptiPlex 5060 Tower installing optical drive\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/installing-optical-drive?guid=guid-20e8e972-ee0d-4739-b982-30e5873d6381&lang=en-us\",\n      \"locator\": \"Slide the optional optical drive into the bay until it clicks; route cables under the drive cage and connect data/power\",\n      \"notes\": \"Optional slim optical drive and routing observation only; not evidence that an ODD is fitted.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.dell.5060.optional_video_module\",\n      \"title\": \"Dell OptiPlex 5060 Tower installing optional VGA module\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-ca/optiplex-5060-desktop/optiplex_5060_mt_service_manual/installing-optional-vga-module?guid=guid-60c2a7f8-f5dd-4b51-941a-bd4a9e41ec6c&lang=en-us\",\n      \"locator\": \"Release rear metal blanking bracket, insert optional video module from inside, connect cable and secure with two M3×3 screws\",\n      \"notes\": \"VGA/HDMI/DisplayPort/Type-C module is optional and configuration-dependent; not asserted as fitted.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.dell.5060.hdd35_assembly\",\n      \"title\": \"Dell OptiPlex 5060 Tower removing 3.5-inch hard-drive assembly\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/removing-35inch-hard-drive-assembly?guid=guid-002dfa35-1f49-46ec-a018-9f59222bc7a3&lang=en-us\",\n      \"locator\": \"Disconnect SATA and power, remove HDD filler bracket, press blue tab and pull assembly\",\n      \"notes\": \"Optional 3.5-inch storage carrier. Exact fitted drive and cage configuration remain unknown.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.dell.5060.hdd35_bracket\",\n      \"title\": \"Dell OptiPlex 5060 Tower removing 3.5-inch drive from bracket\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/removing-35inch-hard-drive-from-the-hard-drive-bracket?guid=guid-7285aec1-874c-4930-a768-d5a5970c686b&lang=en-us\",\n      \"locator\": \"Pull one side of the HDD bracket to disengage pins from drive slots, then lift drive out\",\n      \"notes\": \"Documents a flexible pin retention method rather than a universal screw pattern.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.dell.5060.hdd25_assembly\",\n      \"title\": \"Dell OptiPlex 5060 Tower removing 2.5-inch hard-drive assembly\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/removing-the-25inch-hard-drive-assembly?guid=guid-440f086d-8aaa-4a51-b805-1afe4a9d3ba5&lang=en-us\",\n      \"locator\": \"Disconnect drive data/power, press blue tabs on both sides, pull assembly out\",\n      \"notes\": \"Separate removable 2.5-inch assembly; optional fitted population remains unknown.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.dell.5060.hdd25_bracket\",\n      \"title\": \"Dell OptiPlex 5060 Tower removing 2.5-inch drive from bracket\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/removing-the-25inch-drive-from-the-drive-bracket?guid=guid-4aabdcf4-a7c7-494a-8e0d-cad2b4b0828a&lang=en-us\",\n      \"locator\": \"Pull one side of the bracket to disengage its pins from drive slots, then lift drive out\",\n      \"notes\": \"Documents pin-based drive retention; the package does not invent dimensions or screw positions.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.dell.5060.odd_removal\",\n      \"title\": \"Dell OptiPlex 5060 Tower removing optical drive\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_service_procedure\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_service_manual/removing-optical-drive?guid=guid-f1ff3fd0-8c0b-4cb4-9d0a-498f96f0ff86&lang=en-us\",\n      \"locator\": \"Disconnect ODD data/power, unroute cables from tabs under drive cage, press blue release tab and slide drive out\",\n      \"notes\": \"Slim ODD option is not asserted as fitted. Cable retention tabs are represented as a semantic group only.\",\n      \"access_date\": \"2026-11-27\"\n    },\n    {\n      \"id\": \"src.dell.5060.front_view\",\n      \"title\": \"Dell OptiPlex 5060 Tower front view\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_setup_guide_web\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_setup_and_specs/front-view?guid=guid-cd24c6a2-daef-411f-8e94-0c7e9ff8d174&lang=en-us\",\n      \"locator\": \"Front view text legend callouts 1–9: power button/light, optional optical drive/card reader, HDD activity, headset jack and four front USB ports.\",\n      \"notes\": \"Text legend only. Embedded image visibly labels OptiPlex 5070 under a 5060 guide URL; pixels and coordinates excluded from 5060 placement.\",\n      \"access_date\": \"2026-11-28\"\n    },\n    {\n      \"id\": \"src.dell.5060.back_view\",\n      \"title\": \"Dell OptiPlex 5060 Tower back view\",\n      \"publisher\": \"Dell Technologies\",\n      \"source_type\": \"manufacturer_setup_guide_web\",\n      \"url\": \"https://www.dell.com/support/manuals/en-us/optiplex-5060-desktop/optiplex_5060_mt_setup_and_specs/back-view?guid=guid-2ea3360b-a234-4e0f-a1ec-89da5d329043&lang=en-us\",\n      \"locator\": \"Rear view text legend callouts 1–15: line-out, optional serial/video, DisplayPorts, USB, RJ-45, expansion, AC inlet, optional antennas, indicators and locks.\",\n      \"notes\": \"Text legend only. Embedded image visibly labels OptiPlex 5070 under a 5060 guide URL; pixels and coordinates excluded from 5060 placement.\",\n      \"access_date\": \"2026-11-28\"\n    }\n  ]\n}\n","relationships.json":"{\n  \"schema_version\": \"0.1.0\",\n  \"device_model_id\": \"pc.dell.optiplex-5060-tower.family\",\n  \"relationships\": [\n    {\n      \"id\": \"rel.contains.chassis_frame\",\n      \"from\": \"pc.system.root\",\n      \"to\": \"chassis.frame\",\n      \"type\": \"contains\",\n      \"source_ids\": [\n        \"src.dell.5060.service\",\n        \"src.dell.5060.setup\"\n      ]\n    },\n    {\n      \"id\": \"rel.contains.chassis_base\",\n      \"from\": \"chassis.frame\",\n      \"to\": \"chassis.base\",\n      \"type\": \"contains\",\n      \"source_ids\": [\n        \"src.dell.5060.service\",\n        \"src.dell.5060.setup\"\n      ]\n    },\n    {\n      \"id\": \"rel.contains.chassis_top\",\n      \"from\": \"chassis.frame\",\n      \"to\": \"chassis.top\",\n      \"type\": \"contains\",\n      \"source_ids\": [\n        \"src.dell.5060.service\",\n        \"src.dell.5060.setup\"\n      ]\n    },\n    {\n      \"id\": \"rel.contains.chassis_side_panel\",\n      \"from\": \"chassis.frame\",\n      \"to\": \"chassis.side_panel\",\n      \"type\": \"contains\",\n      \"source_ids\": [\n        \"src.dell.5060.service\",\n        \"src.dell.5060.setup\"\n      ]\n    },\n    {\n      \"id\": \"rel.contains.chassis_front_panel\",\n      \"from\": \"chassis.frame\",\n      \"to\": \"chassis.front_panel\",\n      \"type\": \"contains\",\n      \"source_ids\": [\n        \"s