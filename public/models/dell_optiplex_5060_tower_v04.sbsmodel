label\": \"Power switch connector\",\n          \"component_ids\": [\n            \"motherboard.power_switch_header\"\n          ]\n        },\n        {\n          \"number\": 16,\n          \"label\": \"M.2 SSD connector\",\n          \"component_ids\": [\n            \"motherboard.m2\"\n          ]\n        },\n        {\n          \"number\": 17,\n          \"label\": \"SATA 0 connector · blue\",\n          \"component_ids\": [\n            \"motherboard.sata.1\"\n          ]\n        },\n        {\n          \"number\": 18,\n          \"label\": \"SATA 2 connector · white\",\n          \"component_ids\": [\n            \"motherboard.sata.2\"\n          ]\n        },\n        {\n          \"number\": 19,\n          \"label\": \"Internal speaker connector\",\n          \"component_ids\": [\n            \"motherboard.speaker_header\"\n          ]\n        },\n        {\n          \"number\": 20,\n          \"label\": \"SATA 3 connector · black\",\n          \"component_ids\": [\n            \"motherboard.sata.3\"\n          ]\n        },\n        {\n          \"number\": 21,\n          \"label\": \"SATA 1 connector · black\",\n          \"component_ids\": [\n            \"motherboard.sata.4\"\n          ]\n        },\n        {\n          \"number\": 22,\n          \"label\": \"System power connector · ATX\",\n          \"component_ids\": [\n            \"motherboard.system_power\"\n          ]\n        },\n        {\n          \"number\": 23,\n          \"label\": \"SATA power connector\",\n          \"component_ids\": [\n            \"motherboard.sata_power_header\"\n          ]\n        },\n        {\n          \"number\": 24,\n          \"label\": \"M.2 WLAN connector\",\n          \"component_ids\": [\n            \"motherboard.m2.wlan\"\n          ]\n        },\n        {\n          \"number\": 25,\n          \"label\": \"Coin-cell battery\",\n          \"component_ids\": [\n            \"motherboard.coin_cell\"\n          ]\n        },\n        {\n          \"number\": 26,\n          \"label\": \"Clear CMOS / Password / Service Mode jumper\",\n          \"component_ids\": [\n            \"motherboard.clear_cmos_jumper\"\n          ]\n        }\n      ]\n    },\n    \"fasteners\": {\n      \"screw_table_quantity_total\": 19,\n      \"system_board_to_chassis\": 9,\n      \"psu_to_chassis\": 3,\n      \"other_optional_or_module_fasteners\": 7,\n      \"modeled_individual_instances\": 24,\n      \"source_ids\": [\n        \"src.dell.5060.service\"\n      ],\n      \"notes\": \"24 distinct mounting instances: 9 system-board screws, 3 PSU screws, 4 captive heatsink screws, 4 heatsink-fan screws and 4 system-fan rubber grommets. The 19-entry screw-table sum remains a separate manufacturer table total; optional/module screw counts are not assumed installed.\",\n      \"modeled_screw_instances\": 20,\n      \"modeled_rubber_grommets\": 4\n    },\n    \"platform\": {\n      \"cpu_family\": \"8th-generation Intel Core / Coffee Lake family\",\n      \"socket_family\": \"LGA1151 platform\",\n      \"exact_cpu\": null,\n      \"exact_motherboard_part_number\": null,\n      \"motherboard_revision\": null,\n      \"exact_psu_part_number\": null,\n      \"source_ids\": [\n        \"src.dell.5060.service\"\n      ],\n      \"supported_processors\": [\n        {\n          \"model\": \"Pentium Gold G5400\",\n          \"cores\": 2,\n          \"threads\": 4,\n          \"base_ghz\": 3.7,\n          \"integrated_graphics\": \"UHD Graphics 610\",\n          \"dell_datasheet_power_rating_w\": 65,\n          \"intel_ark_tdp_w\": 58,\n          \"intel_thermal_solution_spec_w\": 65\n        },\n        {\n          \"model\": \"Pentium Gold G5500\",\n          \"cores\": 2,\n          \"threads\": 4,\n          \"base_ghz\": 3.8,\n          \"integrated_graphics\": \"UHD Graphics 630\",\n          \"dell_datasheet_power_rating_w\": 65,\n          \"intel_ark_tdp_w\": 54,\n          \"intel_thermal_solution_spec_w\": 65\n        },\n        {\n          \"model\": \"Core i3-8100\",\n          \"cores\": 4,\n          \"threads\": 4,\n          \"base_ghz\": 3.6,\n          \"integrated_graphics\": \"UHD Graphics 630\",\n          \"dell_datasheet_power_rating_w\": 65\n        },\n        {\n          \"model\": \"Core i3-8300\",\n          \"cores\": 4,\n          \"threads\": 4,\n          \"base_ghz\": 3.7,\n          \"integrated_graphics\": \"UHD Graphics 630\",\n          \"dell_datasheet_power_rating_w\": 65\n        },\n        {\n          \"model\": \"Core i5-8400\",\n          \"cores\": 6,\n          \"threads\": 6,\n          \"base_ghz\": 2.8,\n          \"max_turbo_ghz\": 4,\n          \"integrated_graphics\": \"UHD Graphics 630\",\n          \"dell_datasheet_power_rating_w\": 65\n        },\n        {\n          \"model\": \"Core i5-8500\",\n          \"cores\": 6,\n          \"threads\": 6,\n          \"base_ghz\": 3,\n          \"max_turbo_ghz\": 4.1,\n          \"integrated_graphics\": \"UHD Graphics 630\",\n          \"dell_datasheet_power_rating_w\": 65\n        },\n        {\n          \"model\": \"Core i5-8600\",\n          \"cores\": 6,\n          \"threads\": 6,\n          \"base_ghz\": 3.1,\n          \"max_turbo_ghz\": 4.3,\n          \"integrated_graphics\": \"UHD Graphics 630\",\n          \"dell_datasheet_power_rating_w\": 65\n        },\n        {\n          \"model\": \"Core i7-8700\",\n          \"cores\": 6,\n          \"threads\": 12,\n          \"base_ghz\": 3.2,\n          \"max_turbo_ghz\": 4.6,\n          \"integrated_graphics\": \"UHD Graphics 630\",\n          \"dell_datasheet_power_rating_w\": 65\n        }\n      ],\n      \"processor_notes\": \"The listed CPU models are platform options, not a fitted CPU. Dell's OptiPlex 5060 data sheet lists 65 W for the standard non-T options. Intel ARK separately reports 58 W TDP for G5400 and 54 W for G5500, while both specify a PCG 2015C (65 W) thermal solution; TDP and thermal-solution class are distinct properties. The Dell service manual's processor paragraph contains 35 W entries with abbreviated model names; the data sheet separately identifies 35 W T-suffix CPUs, so that service-manual row is retained as a source discrepancy and not used to assert Tower CPU population.\",\n      \"processor_source_ids\": [\n        \"src.dell.5060.processors\",\n        \"src.dell.5060.spec_sheet\",\n        \"src.intel.g5400\",\n        \"src.intel.g5500\",\n        \"src.dell.5060.service\"\n      ],\n      \"processor_data_semantics\": {\n        \"dell_datasheet_power_rating_w\": \"Power rating as listed in Dell OptiPlex 5060 data sheet for standard non-T processor options; not asserted as measured CPU package power.\",\n        \"intel_ark_tdp_w\": \"Intel processor-level TDP; separately recorded where a primary Intel ARK record is linked.\",\n        \"intel_thermal_solution_spec_w\": \"Intel package thermal-solution class; do not conflate with processor TDP.\",\n        \"service_manual_note\": \"35 W entries in the service-manual processor paragraph are not reconciled to the data sheet's T-suffix options.\"\n      }\n    },\n    \"memory\": {\n      \"slot_count\": 4,\n      \"slot_type\": \"UDIMM\",\n      \"technology\": \"DDR4\",\n      \"ecc\": \"non-ECC\",\n      \"max_capacity_gb\": 64,\n      \"max_per_slot_gb\": 16,\n      \"max_data_rate_mt_s\": {\n        \"Core i5/i7\": 2666,\n        \"Pentium/i3\": 2400\n      },\n      \"fitted_capacity_gb\": null,\n      \"fitted_module_count\": null,\n      \"source_ids\": [\n        \"src.dell.5060.memory\",\n        \"src.dell.5060.boardlayout\"\n      ]\n    },\n    \"storage\": {\n      \"m2_ssd_connectors\": 1,\n      \"m2_ssd_form_factors\": [\n        \"2230\",\n        \"2280\"\n      ],\n      \"m2_ssd_interfaces\": [\n        \"SATA\",\n        \"PCIe\"\n      ],\n      \"m2_wlan_connectors\": 1,\n      \"m2_wlan_form_factor\": \"2230\",\n      \"sata_data_headers\": 4,\n      \"sata_generation_counts\": {\n        \"Gen2\": 1,\n        \"Gen3\": 3\n      },\n      \"sata_gen2_role\": \"Optical drive\",\n      \"supported_drive_families\": [\n        \"2.5-inch SATA drive\",\n        \"3.5-inch SATA drive\",\n        \"M.2 SATA SSD\",\n        \"M.2 PCIe SSD\",\n        \"Slim optical drive\",\n        \"M.2 Optane combinations\"\n      ],\n      \"fitted_drives\": null,\n      \"source_ids\": [\n        \"src.dell.5060.storage\",\n        \"src.dell.5060.board_connectors\"\n      ],\n      \"drive_retention\": {\n        \"3.5-inch\": {\n          \"carrier_release\": \"single blue tab\",\n          \"drive_to_bracket\": \"flexible bracket pins engage drive slots\",\n          \"filler_bracket\": true\n        },\n        \"2.5-inch\": {\n          \"carrier_release\": \"two blue side tabs\",\n          \"drive_to_bracket\": \"flexible bracket pins engage drive slots\"\n        },\n        \"slim_optical_drive\": {\n          \"carrier_release\": \"single blue tab\",\n          \"cable_routing\": \"route data and power leads through retention tabs beneath the drive cage\"\n        }\n      }\n    },\n    \"expansion\": {\n      \"pcie_gen3\": [\n        {\n          \"slot\": \"Slot 2\",\n          \"mechanical\": \"x16\",\n          \"electrical\": \"x16\"\n        },\n        {\n          \"slot\": \"Slot 1\",\n          \"mechanical\": \"x1\",\n          \"electrical\": \"x1\"\n        },\n        {\n          \"slot\": \"Slot 3\",\n          \"mechanical\": \"x1\",\n          \"electrical\": \"x1\"\n        },\n        {\n          \"slot\": \"Slot 4\",\n          \"mechanical\": \"x16\",\n          \"electrical\": \"x4\"\n        }\n      ],\n      \"rear_openings\": 4,\n      \"source_ids\": [\n        \"src.dell.5060.boardlayout\",\n        \"src.dell.5060.board_connectors\"\n      ]\n    },\n    \"power_supply\": {\n      \"family_options\": [\n        {\n          \"wattage_w\": 260,\n          \"efficiency\": \"EPA Bronze\"\n        },\n        {\n          \"wattage_w\": 260,\