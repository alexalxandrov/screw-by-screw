"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.ports\"\n      ],\n      \"notes\": \"Optional module entries are alternatives, not a guaranteed simultaneous port population.\"\n    },\n    {\n      \"id\": \"claim.io.ethernet\",\n      \"subject_id\": \"rear.rj45\",\n      \"predicate\": \"ethernet_port\",\n      \"value\": {\n        \"count\": 1,\n        \"connector\": \"RJ-45\",\n        \"class\": \"Gigabit Ethernet\"\n      },\n      \"unit\": \"port\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.ports\"\n      ]\n    },\n    {\n      \"id\": \"claim.cpu.supported_options\",\n      \"subject_id\": \"motherboard.cpu_socket\",\n      \"predicate\": \"supported_processor_options\",\n      \"value\": [\n        \"Intel Pentium Gold G5400\",\n        \"Intel Pentium Gold G5500\",\n        \"Intel Core i3-8100\",\n        \"Intel Core i3-8300\",\n        \"Intel Core i5-8400\",\n        \"Intel Core i5-8500\",\n        \"Intel Core i5-8600\",\n        \"Intel Core i7-8700\"\n      ],\n      \"unit\": \"models\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.processors\"\n      ],\n      \"notes\": \"Supported orderable CPU family options only; this reference model does not select or install one. A separate service-manual table differs on some TDP values.\"\n    },\n    {\n      \"id\": \"claim.fan.grommet_count\",\n      \"subject_id\": \"cooling.system_fan\",\n      \"predicate\": \"documented_mounting_grommets\",\n      \"value\": 4,\n      \"unit\": \"grommets\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.system_fan\"\n      ],\n      \"notes\": \"Dell documents rubber grommet retention; the four-instance count follows the mounting arrangement in the service procedure, not measured dimensions.\"\n    },\n    {\n      \"id\": \"claim.cpu.heatsink_fasteners\",\n      \"subject_id\": \"cooling.cpu.heatsink\",\n      \"predicate\": \"captive_heatsink_screws\",\n      \"value\": 4,\n      \"unit\": \"screws\",\n      \"confidence_class\": \"manufacturer_data\",\n      \"source_ids\": [\n        \"src.dell.5060.heatsink\"\n      ],\n      \"notes\": \"Loosening order 1–4 is documented; installed screw coordinates and torque are not supplied.\"\n    }\n  ]\n}\n","process_layers.json":"{\n  \"schema_version\": \"0.1.0\",\n  \"device_model_id\": \"pc.dell.optiplex-5060-tower.family\",\n  \"process_layers\": [\n    {\n      \"id\": \"process.cooling\",\n      \"type\": \"cooling\",\n      \"title\": {\n        \"en\": \"CPU and chassis cooling\",\n        \"ru\": \"Охлаждение CPU и корпуса\"\n      },\n      \"mode\": \"qualitative\",\n      \"linked_component_ids\": [\n        \"cooling.assembly\",\n        \"cooling.cpu.heatsink\",\n        \"cooling.cpu.fan\",\n        \"cooling.system_fan\",\n        \"motherboard.cpu_socket\",\n        \"chassis.frame\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.service\"\n      ],\n      \"assumptions\": [\n        \"Positions and airflow are schematic. No CFD or measured temperature is represented.\"\n      ]\n    },\n    {\n      \"id\": \"process.power\",\n      \"type\": \"power_delivery\",\n      \"title\": {\n        \"en\": \"Power supply and board power\",\n        \"ru\": \"Блок питания и питание платы\"\n      },\n      \"mode\": \"qualitative\",\n      \"linked_component_ids\": [\n        \"power.assembly\",\n        \"power.psu\",\n        \"power.psu.fan\",\n        \"power.psu.harness\",\n        \"motherboard.system_power\",\n        \"motherboard.cpu_power\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.service\"\n      ],\n      \"assumptions\": [\n        \"No PSU internal topology, wattage, verified pinout or electrical simulation is claimed.\"\n      ]\n    },\n    {\n      \"id\": \"process.memory\",\n      \"type\": \"memory_topology\",\n      \"title\": {\n        \"en\": \"Memory subsystem · four UDIMM sockets\",\n        \"ru\": \"Подсистема памяти · четыре разъёма UDIMM\"\n      },\n      \"mode\": \"qualitative\",\n      \"linked_component_ids\": [\n        \"motherboard.pcb\",\n        \"motherboard.dimm.1\",\n        \"motherboard.dimm.2\",\n        \"motherboard.dimm.3\",\n        \"motherboard.dimm.4\",\n        \"motherboard.cpu_socket\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.memory\",\n        \"src.dell.5060.boardlayout\"\n      ],\n      \"assumptions\": [\n        \"Shows supported socket count and memory capability only; no channel routing, rank layout, installed DIMMs or timing training is simulated.\"\n      ]\n    },\n    {\n      \"id\": \"process.storage\",\n      \"type\": \"storage_topology\",\n      \"title\": {\n        \"en\": \"Storage interfaces · SATA and M.2\",\n        \"ru\": \"Интерфейсы накопителей · SATA и M.2\"\n      },\n      \"mode\": \"qualitative\",\n      \"linked_component_ids\": [\n        \"motherboard.sata.1\",\n        \"motherboard.sata.2\",\n        \"motherboard.sata.3\",\n        \"motherboard.sata.4\",\n        \"motherboard.sata_power_header\",\n        \"motherboard.m2\",\n        \"motherboard.m2.wlan\",\n        \"storage.assembly\",\n        \"storage.drive_cage\",\n        \"storage.drive25.optional\",\n        \"storage.drive35.optional\",\n        \"storage.m2.optional\",\n        \"storage.optical_drive.optional\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.storage\",\n        \"src.dell.5060.board_connectors\"\n      ],\n      \"assumptions\": [\n        \"Connection capabilities are documented; actual cable routes, drive population, BIOS settings and storage performance are unknown.\"\n      ]\n    },\n    {\n      \"id\": \"process.pcie\",\n      \"type\": \"pcie_expansion\",\n      \"title\": {\n        \"en\": \"PCIe expansion topology\",\n        \"ru\": \"Топология расширения PCIe\"\n      },\n      \"mode\": \"qualitative\",\n      \"linked_component_ids\": [\n        \"motherboard.pcie.x16\",\n        \"motherboard.pcie.x1.1\",\n        \"motherboard.pcie.x1.2\",\n        \"motherboard.pcie.x16.wired_x4\",\n        \"rear.expansion_opening.1\",\n        \"rear.expansion_opening.2\",\n        \"rear.expansion_opening.3\",\n        \"rear.expansion_opening.4\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.boardlayout\",\n        \"src.dell.5060.board_connectors\"\n      ],\n      \"assumptions\": [\n        \"Slot size and electrical lane width follow Dell's specifications; no installed card, lane sharing, chipset routing or board trace geometry is represented.\"\n      ]\n    },\n    {\n      \"id\": \"process.external_io\",\n      \"type\": \"external_connectivity\",\n      \"title\": {\n        \"en\": \"Front and rear external connectivity\",\n        \"ru\": \"Внешние интерфейсы передней и задней панелей\"\n      },\n      \"mode\": \"qualitative\",\n      \"linked_component_ids\": [\n        \"front.io_region\",\n        \"front.audio_combo\",\n        \"front.usb2.powershare\",\n        \"front.usb2\",\n        \"front.usbc.gen2.powershare\",\n        \"front.usb3.gen1\",\n        \"rear.io_region\",\n        \"rear.line_out\",\n        \"rear.displayport.1\",\n        \"rear.displayport.2\",\n        \"rear.usb3.gen1.1\",\n        \"rear.usb3.gen1.2\",\n        \"rear.usb3.gen1.3\",\n        \"rear.usb3.gen1.4\",\n        \"rear.usb2.smartpoweron.1\",\n        \"rear.usb2.smartpoweron.2\",\n        \"rear.rj45\",\n        \"rear.video_module.optional\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.ports\",\n        \"src.dell.5060.boardlayout\"\n      ],\n      \"assumptions\": [\n        \"Port inventory is a static family-level description; data rates, active PHY paths, optional module population and live I/O are not simulated.\"\n      ]\n    }\n  ]\n}\n","assembly_steps.json":"{\n  \"schema_version\": \"0.1.0\",\n  \"device_model_id\": \"pc.dell.optiplex-5060-tower.family\",\n  \"steps\": [\n    {\n      \"id\": \"step.optiplex.remove-side-cover\",\n      \"sequence\": 1,\n      \"title\": {\n        \"en\": \"Remove the side cover\",\n        \"ru\": \"Снять боковую крышку\"\n      },\n      \"description\": {\n        \"en\": \"Remove the cover before service; disconnect AC power and peripherals before opening the chassis.\",\n        \"ru\": \"Снять крышку перед обслуживанием; отключить сетевое питание и периферию перед вскрытием.\"\n      },\n      \"component_ids\": [\n        \"chassis.side_panel\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Disconnect mains power and use ESD precautions.\",\n        \"ru\": \"Отключить сеть и соблюдать защиту от ЭСР.\"\n      },\n      \"prerequisite_step_ids\": [],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\"\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-front-bezel\",\n      \"sequence\": 2,\n      \"title\": {\n        \"en\": \"Remove the front bezel\",\n        \"ru\": \"Снять переднюю декоративную панель\"\n      },\n      \"description\": {\n        \"en\": \"Remove the bezel as listed in Dell's system-board removal prerequisites.\",\n        \"ru\": \"Снять панель по перечню предварительных операций Dell.\"\n      },\n      \"component_ids\": [\n        \"chassis.front_panel\",\n        \"front.io_region\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Release the documented tabs; do not lever against port openings.\",\n        \"ru\": \"Освобождать фиксаторы; не использовать отверстия портов как рычаг.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-side-cover\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\"\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.open-front-door\",\n      \"sequence\": 3,\n      \"title\": {\n        \"en\": \"Open the front panel door\",\n        \"ru\": \"Открыть дверцу передней панели\"\n      },\n      \"description\": {\n        \"en\": \"Open the front door as required by the board service procedure.\",\n        \"ru\": \"Открыть дверцу согласно процедуре обслуживания платы.\"\n      },\n      \"component_ids\": [\n        \"chassis.front_panel\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Do not force the hinge or latch.\",\n        \"ru\": \"Не прикладывать силу к петле или защёлке.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-front-bezel\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\"\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-cpu-fan\",\n      \"sequence\": 4,\n      \"title\": {\n        \"en\": \"Remove the CPU heatsink fan\",\n        \"ru\": \"Снять вентилятор радиатора CPU\"\n      },\n      \"description\": {\n        \"en\": \"Remove the fan before the heatsink; Dell lists this among board-removal prerequisites.\",\n        \"ru\": \"Перед радиатором снять вентилятор; Dell включает это в подготовку к снятию платы.\"\n      },\n      \"component_ids\": [\n        \"cooling.cpu.fan\",\n        \"cooling.assembly\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Disconnect by the connector body, not by the wire.\",\n        \"ru\": \"Отсоединять за корпус разъёма, не тянуть за провод.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.open-front-door\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\",\n        \"src.dell.5060.boardlayout\"\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-heatsink\",\n      \"sequence\": 5,\n      \"title\": {\n        \"en\": \"Loosen four captive heatsink screws and lift the heatsink\",\n        \"ru\": \"Ослабить четыре невыпадающих винта и снять радиатор\"\n      },\n      \"description\": {\n        \"en\": \"Loosen the four captive screws in Dell's 1–4 order, then lift the heatsink. Coordinates and torque are not published.\",\n        \"ru\": \"Ослабить четыре винта в порядке Dell 1–4 и снять радиатор. Координаты и момент затяжки не опубликованы.\"\n      },\n      \"component_ids\": [\n        \"cooling.cpu.heatsink\",\n        \"fastener.cooler.captive.01\",\n        \"fastener.cooler.captive.02\",\n        \"fastener.cooler.captive.03\",\n        \"fastener.cooler.captive.04\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Support the heatsink as the last fastener is released.\",\n        \"ru\": \"Поддерживать радиатор при освобождении последнего винта.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-cpu-fan\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.heatsink\"\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-processor\",\n      \"sequence\": 6,\n      \"title\": {\n        \"en\": \"Release and remove the processor\",\n        \"ru\": \"Освободить и извлечь процессор\"\n      },\n      \"description\": {\n        \"en\": \"After heatsink removal, release the socket lever and processor cover as Dell describes, then lift the CPU out.\",\n        \"ru\": \"После снятия радиатора освободить рычаг сокета и крышку процессора по инструкции Dell, затем извлечь CPU.\"\n      },\n      \"component_ids\": [\n        \"motherboard.cpu_socket\",\n        \"motherboard.pcb\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"LGA contacts are fragile. Hold the CPU by its edges.\",\n        \"ru\": \"Контакты LGA хрупкие. Держать CPU за края.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-heatsink\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.cpu_removal\"\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-expansion-cards\",\n      \"sequence\": 7,\n      \"title\": {\n        \"en\": \"Remove installed expansion cards, if present\",\n        \"ru\": \"Снять установленные платы расширения, если они есть\"\n      },\n      \"description\": {\n        \"en\": \"Remove any fitted expansion cards. Empty slots remain empty; no GPU installation is implied.\",\n        \"ru\": \"Снять установленные платы расширения. Пустые слоты остаются пустыми; наличие GPU не подразумевается.\"\n      },\n      \"component_ids\": [\n        \"motherboard.pcie.x16\",\n        \"motherboard.pcie.x1.1\",\n        \"motherboard.pcie.x1.2\",\n        \"motherboard.pcie.x16.wired_x4\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Release the bracket retainer and slot latch; support the card.\",\n        \"ru\": \"Освободить фиксатор планки и слота; поддерживать плату.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-processor\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\"\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-pcie-ssd\",\n      \"sequence\": 8,\n      \"title\": {\n        \"en\": \"Remove a PCIe SSD, if fitted\",\n        \"ru\": \"Снять PCIe SSD, если он установлен\"\n      },\n      \"description\": {\n        \"en\": \"Remove the PCIe SSD only if fitted; Dell lists it as a prerequisite but the family package does not assert an installed drive.\",\n        \"ru\": \"Снимать PCIe SSD только при наличии; Dell перечисляет этап, но пакет семейства не утверждает наличие диска.\"\n      },\n      \"component_ids\": [\n        \"motherboard.m2\",\n        \"storage.m2.optional\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Retain the SSD screw and spacer if present.\",\n        \"ru\": \"Сохранить винт и стойку SSD, если они есть.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-expansion-cards\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\",\n        \"src.dell.5060.storage\"\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-sd-reader\",\n      \"sequence\": 9,\n      \"title\": {\n        \"en\": \"Remove the optional SD reader, if fitted\",\n        \"ru\": \"Снять картридер SD, если он установлен\"\n      },\n      \"description\": {\n        \"en\": \"Remove the optional SD reader only if present; Dell shows its board connector and lists module removal before board extraction.\",\n        \"ru\": \"Снимать картридер SD только при наличии; Dell показывает разъём платы и перечисляет снятие модуля до извлечения платы.\"\n      },\n      \"component_ids\": [\n        \"storage.sd_reader.optional\",\n        \"motherboard.sd_reader_header\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"A board header alone does not prove a reader is fitted.\",\n        \"ru\": \"Наличие разъёма не доказывает, что картридер установлен.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-pcie-ssd\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\",\n        \"src.dell.5060.boardlayout\"\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-memory\",\n      \"sequence\": 10,\n      \"title\": {\n        \"en\": \"Remove installed memory modules\",\n        \"ru\": \"Извлечь установленные модули памяти\"\n      },\n      \"description\": {\n        \"en\": \"Release the clips and remove installed DIMMs. Four sockets show capability, not fitted memory population.\",\n        \"ru\": \"Освободить фиксаторы и извлечь установленные DIMM. Четыре слота показывают поддержку, а не заполнение.\"\n      },\n      \"component_ids\": [\n        \"motherboard.dimm.1\",\n        \"motherboard.dimm.2\",\n        \"motherboard.dimm.3\",\n        \"motherboard.dimm.4\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Handle modules by their edges and use ESD-safe packaging.\",\n        \"ru\": \"Брать модули за края и использовать антистатическую упаковку.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-sd-reader\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\",\n        \"src.dell.5060.memory\"\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.disconnect-board-cables\",\n      \"sequence\": 11,\n      \"title\": {\n        \"en\": \"Disconnect the system-board cables\",\n        \"ru\": \"Отсоединить кабели системной платы\"\n      },\n      \"description\": {\n        \"en\": \"Dell lists CPU power, HDD/ODD data, internal speaker, system power and SATA connections before board removal.\",\n        \"ru\": \"Dell предписывает отключить питание CPU, линии HDD/ODD, динамик, питание системы и кабели SATA перед снятием платы.\"\n      },\n      \"component_ids\": [\n        \"motherboard.cpu_power\",\n        \"motherboard.system_power\",\n        \"motherboard.sata_power_header\",\n        \"motherboard.sata.1\",\n        \"motherboard.sata.2\",\n        \"motherboard.sata.3\",\n        \"motherboard.sata.4\",\n        \"motherboard.speaker_header\",\n        \"front.speaker\",\n        \"power.psu.harness\",\n        \"storage.assembly\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Confirm AC is disconnected; pull connector bodies, not wires.\",\n        \"ru\": \"Убедиться, что сеть отключена; тянуть за корпуса разъёмов, не за провода.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.remove-memory\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\",\n        \"src.dell.5060.boardlayout\"\n      ]\n    },\n    {\n      \"id\": \"step.optiplex.remove-system-board\",\n      \"sequence\": 12,\n      \"title\": {\n        \"en\": \"Remove nine board screws and lift the system board out\",\n        \"ru\": \"Выкрутить девять винтов и извлечь системную плату\"\n      },\n      \"description\": {\n        \"en\": \"Remove the nine board-to-chassis screws listed by Dell, slide the board to disengage its locating features, then lift it out. Coordinates remain unknown.\",\n        \"ru\": \"Удалить девять винтов крепления платы, сдвинуть её для освобождения позиционирующих элементов и поднять. Координаты неизвестны.\"\n      },\n      \"component_ids\": [\n        \"motherboard.assembly\",\n        \"motherboard.pcb\",\n        \"fastener.motherboard.01\",\n        \"fastener.motherboard.02\",\n        \"fastener.motherboard.03\",\n        \"fastener.motherboard.04\",\n        \"fastener.motherboard.05\",\n        \"fastener.motherboard.06\",\n        \"fastener.motherboard.07\",\n        \"fastener.motherboard.08\",\n        \"fastener.motherboard.09\"\n      ],\n      \"tool_requirements\": [],\n      \"safety_notes\": {\n        \"en\": \"Support the board with both hands; do not bend it.\",\n        \"ru\": \"Поддерживать плату двумя руками; не сгибать.\"\n      },\n      \"prerequisite_step_ids\": [\n        \"step.optiplex.disconnect-board-cables\"\n      ],\n      \"source_ids\": [\n        \"src.dell.5060.board_removal\",\n        \"src.dell.5060.screw_table\"\n      ]\n    }\n  ],\n  \"observations\": [\n    {\n      \"source_id\": \"src.dell.5060.service\",\n      \"locator\": \"Side-cover, PSU, system-board and cooling removal/installation sections\",\n      \"note\": {\n        \"en\": \"Dell publishes service procedures for these assemblies. The exact ordered disassembly sequence has not yet been authored into this family-level package.\",\n        \"ru\": \"Dell публикует процедуры обслуживания этих узлов. Полная последовательность разборки пока не перенесена в этот пакет семейства.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.service\",\n      \"locator\": \"Tower screw-size table and heatsink-fan procedure\",\n      \"note\": {\n        \"en\": \"The table lists 9 board screws and 3 PSU screws; it separately documents four captive heatsink screws and four heatsink-fan screws. Optional-module entries are configuration-dependent.\",\n        \"ru\": \"В таблице указаны 9 винтов платы и 3 винта БП; отдельно описаны четыре невыпадающих винта радиатора и четыре винта вентилятора. Крепёж опциональных модулей зависит от конфигурации.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.system_fan\",\n      \"locator\": \"Removing system fan\",\n      \"note\": {\n        \"en\": \"Dell instructs the technician to disconnect the intrusion-switch cable, unroute it from the grommet, disconnect the fan cable, stretch the rubber mounts and slide the fan out. The family package models four grommet instances but no exact fan coordinates.\",\n        \"ru\": \"Dell предписывает отключить кабель датчика вскрытия, освободить его из втулки, отключить кабель вентилятора, растянуть резиновые крепления и извлечь вентилятор. Пакет семейства содержит четыре экземпляра втулок, но не точные координаты вентилятора.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.psu_removal\",\n      \"locator\": \"Removing PSU\",\n      \"note\": {\n        \"en\": \"Separate PSU procedure: disconnect and unroute cables from retention clips, remove three PSU-to-chassis screws, press the chassis release tab and slide/lift the PSU out. This sequence is not conflated with system-board removal.\",\n        \"ru\": \"Отдельная процедура снятия БП: отключить и освободить кабели из фиксаторов, удалить три винта крепления БП к корпусу, нажать фиксатор корпуса и сдвинуть/поднять БП. Эта последовательность не смешивается со снятием системной платы.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.screw_table\",\n      \"locator\": \"Tower screw-size table\",\n      \"note\": {\n        \"en\": \"Dell lists nine #6-32 × 1.4 mm screws for the system board and three #6-32 × 1.4 mm screws for PSU-to-chassis mounting. Other listed quantities are optional/module-specific and must not be summed as a universal installed count.\",\n        \"ru\": \"Dell указывает девять винтов #6-32 × 1,4 мм для системной платы и три винта #6-32 × 1,4 мм для крепления БП к корпусу. Другие позиции таблицы относятся к опциям и модулям и не должны суммироваться как универсальное установленное количество.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.system_fan\",\n      \"locator\": \"Removing system fan\",\n      \"note\": {\n        \"en\": \"Dell instructs disconnecting the intrusion-switch cable, unrouting it from the grommet, disconnecting the fan cable, stretching the rubber mounts and sliding the fan out. Four grommets are represented; coordinates are not measured.\",\n        \"ru\": \"Dell предписывает отключить кабель датчика вскрытия, освободить его из втулки, отключить вентилятор, растянуть резиновые крепления и извлечь его. Представлены четыре втулки; координаты не измерены.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.psu_removal\",\n      \"locator\": \"Removing PSU\",\n      \"note\": {\n        \"en\": \"Separate procedure: disconnect/unroute cables, remove three PSU screws, press the chassis release tab and slide/lift the PSU out. Not part of board removal.\",\n        \"ru\": \"Отдельная процедура: отключить/освободить кабели, удалить три винта БП, нажать фиксатор корпуса и сдвинуть/поднять БП. Не часть снятия платы.\"\n      }\n    },\n    {\n      \"source_id\": \"src.dell.5060.screw_table\",\n      \"locator\": \"Tower screw-size table\",\n      \"note\": {\n        \"en\": \"Dell lists nine #6-32 × 1.4 mm system-board screws and three #6-32 × 1.4 mm PSU screws. Other entries are optional/module-specific, not a universal installed count.\",\n        \"ru\": \"Dell указывает девять винтов #6-32 × 1,4 мм системной платы и три винта #6-32 × 1,4 мм БП. Остальные позиции относятся к опциям/модулям, а не к универсальному установленному количеству.\"\n      }\n    }\n  ],\n  \"status\": \"manufacturer_documented_partial_procedure\",\n  \"scope_note\": {\n    \"en\": \"Dell-documented system-board removal chain only. Not a complete teardown/reassembly guide and not evidence that optional devices are installed. PSU and system-fan removal are separate procedures.\",\n    \"ru\": \"Только последовательность снятия системной платы по руководству Dell. Не полная инструкция по разборке/сборке и не доказательство установки опциональных устройств. Для БП и корпусного вентилятора предусмотрены отдельные процедуры.\"\n  }\n}\n","learning.json":"{\n  \"schema_version\": \"0.1.0\",\n  \"device_model_id\": \"pc.dell.optiplex-5060-tower.family\",\n  \"questions\": [\n    {\n      \"id\": \"learn.optiplex.dimensions\",\n      \"prompt\": {\n        \"en\": \"Which are the published Tower dimensions?\",\n        \"ru\": \"Какие размеры Tower опубликованы Dell?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"350 × 154 × 274 mm\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"350 × 244 × 274 mm\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"154 × 154 × 274 mm\"\n        }\n      ],\n      \"correct_choice_id\": \"a\",\n      \"explanation\": {\n        \"en\": \"The family-level envelope is 350 mm high, 154 mm wide and 274 mm deep.\",\n        \"ru\": \"Габариты семейства: 350 мм высота, 154 мм ширина, 274 мм глубина.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.setup\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.fasteners\",\n      \"prompt\": {\n        \"en\": \"Does the screw-table sum of 19 prove that every retail configuration has exactly 19 screws installed?\",\n        \"ru\": \"Доказывает ли сумма 19 в таблице, что в каждой комплектации установлено ровно 19 винтов?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"Yes / Да\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"No; optional modules and configuration matter / Нет; важны опции и комплектация\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"The total includes optional and module-specific fasteners; it is not a universal installed count.\",\n        \"ru\": \"Сумма включает крепёж опциональных модулей и не является универсальным количеством установленных винтов.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.service\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.memory.capacity\",\n      \"prompt\": {\n        \"en\": \"How many UDIMM sockets and what maximum memory capacity does Dell specify?\",\n        \"ru\": \"Сколько разъёмов UDIMM и какой максимальный объём памяти указывает Dell?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"2 sockets / 32 GB\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"4 sockets / 64 GB\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"8 sockets / 128 GB\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"Dell specifies four UDIMM sockets and up to 64 GB total, with up to 16 GB per socket.\",\n        \"ru\": \"Dell указывает четыре разъёма UDIMM и до 64 ГБ суммарно, до 16 ГБ на разъём.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.memory\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.pcie.slots\",\n      \"prompt\": {\n        \"en\": \"Which PCIe slot has a mechanical x16 connector but is electrically wired for x4?\",\n        \"ru\": \"Какой слот PCIe имеет физический разъём x16, но электрически подключён как x4?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"Slot 2\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"Slot 1\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"Slot 4\"\n        }\n      ],\n      \"correct_choice_id\": \"c\",\n      \"explanation\": {\n        \"en\": \"Dell identifies Slot 4 as PCIe x16 mechanical with x4 electrical wiring, Revision 3.0.\",\n        \"ru\": \"Dell обозначает Slot 4 как механический PCIe x16 с электрическим подключением x4, Revision 3.0.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.boardlayout\",\n        \"src.dell.5060.board_connectors\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.sata.generations\",\n      \"prompt\": {\n        \"en\": \"How are the four SATA data headers divided by generation in Dell's connector specification?\",\n        \"ru\": \"Как по поколению распределены четыре SATA-разъёма в спецификации Dell?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"Four Gen3\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"One Gen2 and three Gen3\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"Two Gen2 and two Gen3\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"One SATA Gen2 header is assigned to the optical-drive path; the other three are Gen3.\",\n        \"ru\": \"Один разъём SATA Gen2 назначен для оптического привода; остальные три относятся к Gen3.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.board_connectors\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.m2.sockets\",\n      \"prompt\": {\n        \"en\": \"Does the platform use the same M.2 connector for SSD and WLAN?\",\n        \"ru\": \"Использует ли платформа один и тот же M.2-разъём для SSD и WLAN?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"Yes, one shared socket\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"No, separate SSD and WLAN sockets\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"No M.2 sockets are documented\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"Dell lists one M.2 SSD connector supporting 2230/2280 and a separate M.2 2230 WLAN connector.\",\n        \"ru\": \"Dell указывает один разъём M.2 SSD для 2230/2280 и отдельный разъём M.2 2230 для WLAN.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.board_connectors\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.psu.options\",\n      \"prompt\": {\n        \"en\": \"What power-supply options are listed for this Tower platform?\",\n        \"ru\": \"Какие варианты блока питания указаны для платформы Tower?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"180 W Bronze only\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"260 W Bronze or 260 W Platinum\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"500 W Gold only\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"The setup specification lists alternative 260 W EPA Bronze and 260 W EPA Platinum PSU configurations; the fitted option is unknown.\",\n        \"ru\": \"В спецификации указаны альтернативные варианты БП 260 Вт EPA Bronze и 260 Вт EPA Platinum; установленный вариант неизвестен.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.power\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.callouts\",\n      \"prompt\": {\n        \"en\": \"Does the 26-number motherboard illustration mean the board contains exactly 26 components?\",\n        \"ru\": \"Означает ли схема платы с 26 номерами, что на плате ровно 26 компонентов?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"Yes, each number is one discrete component\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"No, some numbers identify groups or connectors\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"It is the screw count\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"Callouts identify locations and functions; for example, one memory callout covers four physical DIMM sockets.\",\n        \"ru\": \"Номера обозначают позиции и функции; например, одна позиция памяти охватывает четыре физических слота DIMM.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.boardlayout\"\n      ]\n    },\n    {\n      \"id\": \"learn.optiplex.cpu.configuration\",\n      \"prompt\": {\n        \"en\": \"Does the family-level reference package identify the CPU fitted in an individual PC?\",\n        \"ru\": \"Определяет ли пакет семейства, какой процессор установлен в конкретном компьютере?\"\n      },\n      \"choices\": [\n        {\n          \"id\": \"a\",\n          \"label\": \"Yes, it is always an i7-8700\"\n        },\n        {\n          \"id\": \"b\",\n          \"label\": \"No, it records supported options, not the fitted CPU\"\n        },\n        {\n          \"id\": \"c\",\n          \"label\": \"Yes, it is always an i5-8400\"\n        }\n      ],\n      \"correct_choice_id\": \"b\",\n      \"explanation\": {\n        \"en\": \"The package lists manufacturer-supported processor options but does not choose a factory configuration or physical sample.\",\n        \"ru\": \"Пакет перечисляет поддерживаемые производителем варианты процессоров, но не выбирает заводскую конфигурацию или физический экземпляр.\"\n      },\n      \"source_ids\": [\n        \"src.dell.5060.processors\"\n      ]\n    }\n  ]\n}\n","animations.json":"{\n  \"schema_version\": \"0.1.0\",\n  \"device_model_id\": \"pc.dell.optiplex-5060-tower.family\",\n  \"clips\": []\n}\n","release.json":"{\n  \"schema_version\": \"0.1.0\",\n  \"model_id\": \"pc.dell.optiplex-5060-tower.family\",\n  \"part_number\": null,\n  \"package_version\": \"0.2.0\",\n  \"status\": \"research_blockout\",\n  \"geometry_status\": \"illustrative_proxy_not_cad\",\n  \"identity_scope\": \"platform_family\",\n  \"file_count\": 10,\n  \"content_coverage\": {\n    \"motherboard_callouts\": 26,\n    \"semantic_components\": 115,\n    \"relationship_count\": 123,\n    \"process_layers\": 6,\n    \"assembly_steps\": 12,\n    \"learning_questions\": 9,\n    \"documented_source_records\": 15,\n    \"geometry_nodes\": 58,\n    \"optional_population_unknown\": true,\n    \"motherboard_callout_mappings\": 26,\n    \"technical_claims\": 29\n  }\n}\n","scene.glb":""}}